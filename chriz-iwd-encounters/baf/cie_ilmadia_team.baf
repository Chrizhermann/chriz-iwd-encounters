IF
  Global("CIE_ILM_TEAM","MYAREA",0)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    SetGlobal("CIE_ILM_TEAM","MYAREA",1)
    Continue()
END

IF
  !Allegiance(Myself,ENEMY)
  !Global("CIE_ILM_TEAM","MYAREA",0)
THEN
  RESPONSE #100
    Enemy()
    SetGlobal("CIE_ILM_TEAM","MYAREA",1)
    Continue()
END

IF
  ActionListEmpty()
  !Global("CIE_ILM_TEAM","MYAREA",0)
  Allegiance(Myself,ENEMY)
  !See([PC])
THEN
  RESPONSE #100
    MoveToObject(Player1)
  RESPONSE #100
    NoAction()
END

IF
  Global("CIE_ILM_TEAM","MYAREA",0)
  AttackedBy([GOODCUTOFF],DEFAULT)
THEN
  RESPONSE #100
    Enemy()
    SetGlobal("CIE_ILM_TEAM","MYAREA",1)
    Continue()
END


