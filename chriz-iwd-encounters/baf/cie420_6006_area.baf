IF
  Global("LICH_MINIONS_FOLLOW","MYAREA",1)
  Global("CIE_6006_RALLY","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CIE_6006_RALLY","MYAREA",1)
    ActionOverride("CIE606_M01",Enemy())
    ActionOverride("CIE606_M01",MoveToObject(Player1))
    ActionOverride("CIE606_M02",Enemy())
    ActionOverride("CIE606_M02",MoveToObject(Player1))
    ActionOverride("CIE606_M03",Enemy())
    ActionOverride("CIE606_M03",MoveToObject(Player1))
    Continue()
END

IF
  !Global("LICH_MINIONS_FOLLOW","MYAREA",1)
  !Global("CIE_6006_RALLY","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CIE_6006_RALLY","MYAREA",0)
    Continue()
END
