// Decided encounter blocks; based on the IWD:EE game rules.
IF
  Global("CREATURE_STATE_VARBit6","LOCALS",1)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    AttackReevaluate(LastSeenBy(Myself),75)
END

IF
  Global("CREATURE_STATE_VARBit6","LOCALS",1)
  AttackedBy(NearestEnemyOf(Myself),DEFAULT)
THEN
  RESPONSE #100
    MoveToObject(LastAttackerOf(Myself))
END

IF
  AttackedBy([GOODCUTOFF],DEFAULT)
THEN
  RESPONSE #100
    SetGlobal("CREATURE_STATE_VARBit6","LOCALS",1)
    Enemy()
    Continue()
END

IF
  See([0.0.DWARF])
THEN
  RESPONSE #100
    AttackReevaluate(LastSeenBy(Myself),75)
END

IF
  AttackedBy([0.0.DWARF],DEFAULT)
THEN
  RESPONSE #100
    MoveToObject(LastAttackerOf(Myself))
END

IF
  !Global("CREATURE_STATE_VARBit6","LOCALS",1)
  !See([0.0.DWARF])
THEN
  RESPONSE #100
    SetGlobal("CREATURE_STATE_VARBit6","LOCALS",1)
END
