// Decided encounter blocks; based on the IWD:EE game rules.
IF
  OnCreation()
  Global("SPRITE_IS_DEADYXUNOMEI","GLOBAL",3)
THEN
  RESPONSE #100
    DestroySelf()
END

IF
  !Global("KULDAHAR_FORCEREMOVE","GLOBAL",0)
THEN
  RESPONSE #100
    DestroySelf()
END

IF
  OnCreation()
  Global("SPRITE_IS_DEADYXUNOMEI","GLOBAL",2)
  !GlobalTimerNotExpired("2100_ATTACK","GLOBAL")
THEN
  RESPONSE #100
    DestroySelf()
END
