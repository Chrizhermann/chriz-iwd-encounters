    ActionOverride(Player4,LeaveAreaLUA("AR1100","LOAD1100",[889.847],NW))
    ActionOverride(Player5,LeaveAreaLUA("AR1100","LOAD1100",[966.802],NW))
    ActionOverride(Player6,LeaveAreaLUA("AR1100","LOAD1100",[996.860],NW))
    LeaveAreaLUAPanic("AR1100","LOAD1100",[817.765],NW)
    LeaveAreaLUA("AR1100","LOAD1100",[817.765],NW)
