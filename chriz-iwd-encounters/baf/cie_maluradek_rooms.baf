// Decided encounter blocks; based on the IWD:EE game rules.
IF
  Global("ATTACK_SET","LOCALS",0)
  !Global("TELEPORT_1","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
  !Global("TELEPORT_2","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
  !Global("TELEPORT_3","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("ATTACK_SET","LOCALS",2)
    SetGlobal("TELEPORT_SET","LOCALS",0)
    Continue()
END

IF
  Global("ATTACK_SET","LOCALS",0)
  Global("TELEPORT_SET","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",1)
    Continue()
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",2)
    Continue()
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",3)
    Continue()
  RESPONSE #100
    SetGlobal("ATTACK_SET","LOCALS",1)
    SetGlobal("TELEPORT_SET","LOCALS",0)
    Continue()
END

IF
  Global("TELEPORT_SET","LOCALS",2)
  !Global("TELEPORT_2","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",3)
    Continue()
END

IF
  Global("TELEPORT_SET","LOCALS",3)
  !Global("TELEPORT_3","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",1)
    Continue()
END

IF
  Global("TELEPORT_SET","LOCALS",1)
  !Global("TELEPORT_1","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("TELEPORT_SET","LOCALS",2)
    Continue()
END

IF
  Global("TELEPORT_SET","LOCALS",1)
  Global("TELEPORT_1","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    ReallyForceSpellRES("cttelvis",NearestEnemyOf(Myself))
    ActionOverride(NearestEnemyOf(Myself),ForceSpellPoint([1749.1145],INNATE_CRYPT_THING_TELEPORT))
    Wait(2)
    SetGlobal("TELEPORT_SET","LOCALS",0)
    SetGlobal("ATTACK_SET","LOCALS",1)
    SetGlobal("TELEPORT_1","MYAREA",1)
END

IF
  Global("TELEPORT_SET","LOCALS",2)
  Global("TELEPORT_2","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    ReallyForceSpellRES("cttelvis",NearestEnemyOf(Myself))
    ActionOverride(NearestEnemyOf(Myself),ForceSpellPoint([844.1167],INNATE_CRYPT_THING_TELEPORT))
    Wait(2)
    SetGlobal("TELEPORT_SET","LOCALS",0)
    SetGlobal("ATTACK_SET","LOCALS",1)
    SetGlobal("TELEPORT_2","MYAREA",1)
END

IF
  Global("TELEPORT_SET","LOCALS",3)
  Global("TELEPORT_3","MYAREA",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    ReallyForceSpellRES("cttelvis",NearestEnemyOf(Myself))
    ActionOverride(NearestEnemyOf(Myself),ForceSpellPoint([1534.1862],INNATE_CRYPT_THING_TELEPORT))
    Wait(2)
    SetGlobal("TELEPORT_SET","LOCALS",0)
    SetGlobal("ATTACK_SET","LOCALS",1)
    SetGlobal("TELEPORT_3","MYAREA",1)
END
