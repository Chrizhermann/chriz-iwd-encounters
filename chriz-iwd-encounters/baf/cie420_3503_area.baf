IF
  Global("CIE_3503_START","MYAREA",0)
  OR(2)
    !CombatCounter(0)
    !Global("MAP_GROUP_HOSTILE1","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CIE_3503_START","MYAREA",1)
    SetGlobalTimer("CIE_3503_T","MYAREA",27)
    Continue()
END

IF
  Global("CIE_3503_START","MYAREA",1)
  Global("CIE_3503_WAVE","MYAREA",0)
  GlobalTimerExpired("CIE_3503_T","MYAREA")
THEN
  RESPONSE #100
    SetGlobal("CIE_3503_WAVE","MYAREA",1)
    SetGlobalTimer("CIE_3503_T","MYAREA",27)
    Continue()
END

IF
  Global("CIE_3503_START","MYAREA",1)
  Global("CIE_3503_WAVE","MYAREA",1)
  GlobalTimerExpired("CIE_3503_T","MYAREA")
THEN
  RESPONSE #100
    SetGlobal("CIE_3503_WAVE","MYAREA",2)
    Continue()
END
