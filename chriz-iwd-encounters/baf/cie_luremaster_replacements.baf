// Decided encounter blocks; based on the IWD:EE game rules.
IF
  GlobalGT("%cie_lur_hero%","GLOBAL",0)
  Global("#spectral_reinforcements","AR9711",0)
THEN
  RESPONSE #100
    IncrementGlobal("%cie_lur_hero%","GLOBAL",-1)
    IncrementGlobal("#spectral_reinforcements","AR9711",1)
    CreateCreature("trsph4",[632.602],S)
END

