IF
  Global("LICH_MINIONS_FOLLOW","MYAREA",1)
  Global("CIE_6005_RALLY","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CIE_6005_RALLY","MYAREA",1)
    SetGlobal("MAP_GROUP_HOSTILE3","MYAREA",1)
    SetGlobal("MAP_GROUP_HOSTILE4","MYAREA",1)
    ActionOverride("CIE605_M01",Enemy())
    ActionOverride("CIE605_M01",MoveToObject(Player1))
    ActionOverride("CIE605_M02",Enemy())
    ActionOverride("CIE605_M02",MoveToObject(Player1))
    ActionOverride("CIE605_M03",Enemy())
    ActionOverride("CIE605_M03",MoveToObject(Player1))
    ActionOverride("CIE605_M04",Enemy())
    ActionOverride("CIE605_M04",MoveToObject(Player1))
    ActionOverride("CIE605_M05",Enemy())
    ActionOverride("CIE605_M05",MoveToObject(Player1))
    ActionOverride("CIE605_M06",Enemy())
    ActionOverride("CIE605_M06",MoveToObject(Player1))
    ActionOverride("CIE605_M07",Enemy())
    ActionOverride("CIE605_M07",MoveToObject(Player1))
    ActionOverride("CIE605_M08",Enemy())
    ActionOverride("CIE605_M08",MoveToObject(Player1))
    ActionOverride("CIE605_M09",Enemy())
    ActionOverride("CIE605_M09",MoveToObject(Player1))
    ActionOverride("CIE605_M10",Enemy())
    ActionOverride("CIE605_M10",MoveToObject(Player1))
    ActionOverride("CIE605_M11",Enemy())
    ActionOverride("CIE605_M11",MoveToObject(Player1))
    ActionOverride("CIE605_M12",Enemy())
    ActionOverride("CIE605_M12",MoveToObject(Player1))
    Continue()
END

IF
  !Global("LICH_MINIONS_FOLLOW","MYAREA",1)
  !Global("CIE_6005_RALLY","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CIE_6005_RALLY","MYAREA",0)
    Continue()
END
