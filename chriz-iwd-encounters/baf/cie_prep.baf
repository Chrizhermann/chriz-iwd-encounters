IF
  Global("CIE_GROUP","LOCALS",0)
  DifficultyGT(NORMAL)
  OR(2)
    Difficulty(HARDEST)
    LevelGT(Myself,6)
  Allegiance(Myself,ENEMY)
  OR(3)
    Class(Myself,CLERIC_ALL)
    Class(Myself,DRUID_ALL)
    Class(Myself,SHAMAN)
  See(NearestEnemyOf(Myself))
