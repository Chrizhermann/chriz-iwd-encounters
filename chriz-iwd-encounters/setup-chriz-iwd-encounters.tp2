BACKUP ~weidu_external/backup/chriz-iwd-encounters~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-iwd-encounters)~
VERSION ~v0.1.0~

ALWAYS
  INCLUDE ~chriz-iwd-encounters/lib/cie_shared.tpa~
END

LANGUAGE ~English~ ~english~ ~chriz-iwd-encounters/languages/english/setup.tra~

// ============================================================
// chriz-iwd-encounters: small fight upgrades on top of Sword Coast
// Stratagems for Icewind Dale: Enhanced Edition. Install right after SCS.
//
// 100 SCS caster-AI repairs: enemy casters SCS meant to convert but leaves
//     without a working spell AI on IWD:EE
// 200 enemy priests prepare when they first see the party (Core Rules and up)
// 300 Belhifet's final fight (works with and without SCS)
// 310 Yxunomei and her temple in Dragon's Eye (works with and without SCS)
// 320 the orog raid on Kuldahar (works with and without SCS)
// 330 Joril's throne room in Wyrm's Tooth (works with and without SCS)
// 340 Maiden Ilmadia's forge in Lower Dorn's Deep (works with and without SCS)
// 350 the Idol in Poquelin's temple (works with and without SCS)
// 360 Poquelin in the Ascension Cave (works with and without SCS)
//
// Boss fights follow from 300 on, one component each, so a later version can add
// one at the end of an existing install.
//
// docs/components.md describes each change in engine-neutral terms.
// ============================================================

BEGIN @100 DESIGNATED 100
LABEL ~chriz-iwd-encounters-scs-caster-repairs~
REQUIRE_PREDICATE GAME_IS ~iwdee~ @9000
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ ~6030~ OR MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ ~6040~) @9001
INCLUDE ~chriz-iwd-encounters/lib/cie_scs_repairs.tpa~
LAF cie_scs_caster_repairs END

BEGIN @200 DESIGNATED 200
LABEL ~chriz-iwd-encounters-priest-prep~
REQUIRE_PREDICATE GAME_IS ~iwdee~ @9000
REQUIRE_PREDICATE MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ ~6040~ @9002
INCLUDE ~chriz-iwd-encounters/lib/cie_priest_prep.tpa~
LAF cie_priest_prep END

BEGIN @300 DESIGNATED 300
LABEL ~chriz-iwd-encounters-belhifet~
REQUIRE_PREDICATE GAME_IS ~iwdee~ @9000
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~belhif.cre~) AND (FILE_EXISTS_IN_GAME ~ar1105.are~) @9003
INCLUDE ~chriz-iwd-encounters/lib/cie_belhifet.tpa~
LAF cie_belhifet END

