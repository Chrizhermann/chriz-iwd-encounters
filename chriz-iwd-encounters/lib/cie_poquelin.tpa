// Component 360: Poquelin in the Ascension Cave (AR8013, Lower Dorn's Deep),
// designed with Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - 420 hit points (base game 250): he escapes at half, so the fight lasts long
//     enough for his waves to matter.
//   - Below three quarters he jumps away (Dimension Door), calls Fire Storm around
//     himself, and the next wave comes at once.
//   - Repairs: no instant death, petrification, disintegration or imprisonment
//     takes him (his minimum hit point only stops damage; dying outright skipped
//     the escape and the move to Easthaven); the escape cutscenes find him by the
//     script name his placement gives him.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_poquelin BEGIN
  OUTER_SPRINT cie_poq_area_script ~~
  COPY_EXISTING ~ar8013.are~ ~override~
    READ_ASCII 0x94 cie_poq_area_script (8) NULL
  BUT_ONLY
  ACTION_IF (~%cie_poq_area_script%~ STRING_EQUAL ~~) OR (~%cie_poq_area_script%~ STRING_EQUAL_CASE ~NONE~)
      OR (!FILE_EXISTS_IN_GAME ~%cie_poq_area_script%.bcs~) BEGIN
    FAIL ~chriz-iwd-encounters: ar8013.are has no area script.~
  END
  // his placement: script, script name (actor name when flag bit 3 is set)
  OUTER_SPRINT cie_poq_script ~~
  OUTER_SPRINT cie_poq_name ~~
  OUTER_SET cie_poq_x = 0
  OUTER_SET cie_poq_y = 0
  COPY_EXISTING ~ar8013.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      PATCH_IF (~%cre%~ STRING_EQUAL ~POQUELIN~) AND (~%cie_poq_script%~ STRING_EQUAL ~~) BEGIN
        READ_LONG (actor + 0x28) flags
        READ_ASCII actor name (32) NULL
        READ_SHORT (actor + 0x20) cie_poq_x
        READ_SHORT (actor + 0x22) cie_poq_y
        PATCH_IF (flags BAND 8) BEGIN
          INNER_PATCH_SAVE cie_poq_name ~%name%~ BEGIN
            REPLACE_TEXTUALLY ~ ~ ~~
          END
        END
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (~%cie_poq_script%~ STRING_EQUAL ~~) BEGIN
            SPRINT cie_poq_script ~%script%~
          END
        END
      END
    END
  BUT_ONLY
  ACTION_IF (~%cie_poq_script%~ STRING_EQUAL ~~) OR (!FILE_EXISTS_IN_GAME ~%cie_poq_script%.bcs~) BEGIN
    FAIL ~chriz-iwd-encounters: ar8013.are has no Poquelin (POQUELIN) with a script.~
  END

  LAF cie_poquelin_creature END
  LAF cie_poquelin_jump END
  LAF cie_poquelin_cutscenes END
END

// 420 hit points; protections from what kills or removes him outright: opcodes 13
// (instant death), 55 (slay), 134 (petrification), 209 (Power Word: Kill), 211
// (imprisonment), 238 (disintegration). On a copy of his creature (CIEPOQ) that only
// this cave's placement uses: the finale in Easthaven places the same creature file.
DEFINE_ACTION_FUNCTION cie_poquelin_creature BEGIN
  OUTER_SET cie_poq_copied = 0
  COPY_EXISTING ~ar8013.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      LPF cie_embedded_cre INT_VAR actor RET embedded = offset END
      PATCH_IF (~%cre%~ STRING_EQUAL ~POQUELIN~) AND (embedded = 0) BEGIN
        WRITE_ASCII (actor + 0x80) ~CIEPOQ~ (8)
        SET cie_poq_copied += 1
      END
    END
  BUT_ONLY
  ACTION_IF (cie_poq_copied = 0) BEGIN
    WARN ~chriz-iwd-encounters: Poquelin's placement in ar8013.are carries its own creature; his hit points and protections stay.~
  END ELSE BEGIN
    COPY_EXISTING ~poquelin.cre~ ~override/CIEPOQ.cre~
      LPF cie_raise_creature INT_VAR hp = 420 RET old_hp old_apr old_thac0 END
      PATCH_FOR_EACH op IN 13 55 134 209 211 238 BEGIN
        LPF ADD_CRE_EFFECT INT_VAR opcode = 101 target = 1 timing = 9 parameter2 = op END
      END
    PRINT ~chriz-iwd-encounters: in the Ascension Cave Poquelin (CIEPOQ) has %old_hp% -> 420 hit points and nothing kills or removes him outright.~
  END
END

// The jump: on top of his script, once between three quarters and half his hit
// points (the escape at half comes first), a Dimension Door to the other of his two
// places (where he stands and where his opener jumps to), then Fire Storm around
// himself (he is fire immune). His script sets CIE_POQ_WAVE; the area script then
// ends the pause before the next wave (only between waves, not in a spawn window).
DEFINE_ACTION_FUNCTION cie_poquelin_jump BEGIN
  OUTER_SET cie_poq_door_x = 0
  OUTER_SET cie_poq_door_y = 0
  // the opener's Dimension Door point, from his script
  COPY_EXISTING ~%cie_poq_script%.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_EVALUATE CASE_INSENSITIVE ~ForceSpellPoint(\[\([0-9]+\)\.\([0-9]+\)\],WIZARD_DIMENSION_DOOR)~ BEGIN
        PATCH_IF (cie_poq_door_x = 0) BEGIN
          SET cie_poq_door_x = MATCH1
          SET cie_poq_door_y = MATCH2
        END
      END ~%MATCH0%~
    END
  BUT_ONLY
  ACTION_IF (cie_poq_x = 0) OR (cie_poq_door_x = 0) BEGIN
    WARN ~chriz-iwd-encounters: Poquelin's two places are not known (placement [%cie_poq_x%.%cie_poq_y%], opener's jump [%cie_poq_door_x%.%cie_poq_door_y%]); no jump at three quarters.~
  END ELSE BEGIN
    EXTEND_TOP ~%cie_poq_script%.bcs~ ~chriz-iwd-encounters/baf/cie_poquelin_jump.baf~ EVALUATE_BUFFER
    EXTEND_TOP ~%cie_poq_area_script%.bcs~ ~chriz-iwd-encounters/baf/cie_poquelin_wave.baf~
    PRINT ~chriz-iwd-encounters: below three quarters Poquelin jumps between [%cie_poq_x%.%cie_poq_y%] and [%cie_poq_door_x%.%cie_poq_door_y%], calls Fire Storm, and the next wave comes at once.~
  END
END

// The escape cutscenes (the ones his script starts below half) name him "POQUELIN",
// his creature's script name; his placement names him by its actor name.
DEFINE_ACTION_FUNCTION cie_poquelin_cutscenes BEGIN
  ACTION_IF (~%cie_poq_name%~ STRING_COMPARE ~~) AND (~%cie_poq_name%~ STRING_COMPARE_CASE ~POQUELIN~) BEGIN
    ACTION_CLEAR_ARRAY cie_poq_cutscenes
    COPY_EXISTING ~%cie_poq_script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~StartCutSceneEx("\([^"]+\)"~ BEGIN
          SPRINT cutscene ~%MATCH1%~
          TO_UPPER cutscene
          SPRINT $cie_poq_cutscenes(~%cutscene%~) ~1~
        END ~%MATCH0%~
      END
    BUT_ONLY
    OUTER_SET cie_poq_named = 0
    ACTION_PHP_EACH cie_poq_cutscenes AS cutscene => unused BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%cutscene%.bcs~ BEGIN
        COPY_EXISTING ~%cutscene%.bcs~ ~override~
          DECOMPILE_AND_PATCH BEGIN
            REPLACE_EVALUATE CASE_INSENSITIVE ~"POQUELIN"~ BEGIN
              SET cie_poq_named += 1
            END ~"%cie_poq_name%"~
          END
        BUT_ONLY
      END
    END
    PRINT ~chriz-iwd-encounters: Poquelin's escape cutscenes name him %cie_poq_name% (%cie_poq_named% place(s)).~
  END
END
