// Component 390: Icasaracht and her soul gem (AR9604, the end of Heart of Winter),
// designed with Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - 650 hit points for Icasaracht (base game 400), 250 for her soul gem (150).
//   - The court's healing from the base game is not restored: in IWD:EE Cure spells did
//     not heal Icasaracht in the lab, they do not work on the gem (a golem), and the gem
//     stays invisible.
//   - Repairs: the fallback for an Icasaracht who dies without her last-hit-point
//     cutscene no longer creates a second gem and fills the gem's ring slot as the normal
//     path does; the second underpriestess SCS makes (DWSARU0) gets the potions of the
//     first; the underpriestesses' five attacks per round (a typo) become one.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_icasaracht BEGIN
  LAF cie_area_script STR_VAR area = ~ar9604~ fallback = ~ar9604~ RET cie_ica_area_script = script END

  // the gem's script name (its death variable)
  OUTER_SPRINT cie_ica_gem ~GEM~
  ACTION_IF FILE_EXISTS_IN_GAME ~dlsgem.cre~ BEGIN
    COPY_EXISTING ~dlsgem.cre~ ~override~
      WRITE_ASCII 0x280 ~GEM~ (32)
    BUT_ONLY
  END

  LAF cie_icasaracht_hit_points END
  LAF cie_icasaracht_fallback END
  LAF cie_icasaracht_underpriestesses END
END

// 650 and 250 hit points (final values).
DEFINE_ACTION_FUNCTION cie_icasaracht_hit_points BEGIN
  ACTION_FOR_EACH pair IN ~icasa 650~ ~dlsgem 250~ BEGIN
    OUTER_SPRINT cre ~~
    OUTER_SET hp = 0
    OUTER_INNER_PATCH ~%pair%~ BEGIN
      REPLACE_EVALUATE ~\([a-z0-9_#]+\) \([0-9]+\)~ BEGIN
        SPRINT cre ~%MATCH1%~
        SET hp = MATCH2
      END ~%MATCH0%~
    END
    ACTION_IF FILE_EXISTS_IN_GAME ~%cre%.cre~ BEGIN
      COPY_EXISTING ~%cre%.cre~ ~override~
        LPF cie_raise_creature INT_VAR hp RET old_hp old_apr old_thac0 END
      BUT_ONLY
      PRINT ~chriz-iwd-encounters: %cre% has %old_hp% -> %hp% hit points.~
    END ELSE BEGIN
      PRINT ~chriz-iwd-encounters: the external creature %cre%.cre is absent.~
    END
  END
END

// The fallback when Icasaracht dies without her last-hit-point cutscene: with the gem
// already there (the area script creates it on the first visit) the cutscene runs
// without creating a second one; the cutscene fills the gem's ring slot as the normal
// path does instead of EquipItemEx("RING91",0).
DEFINE_ACTION_FUNCTION cie_icasaracht_fallback BEGIN
  LAF cie_write_script_blocks STR_VAR script = EVAL ~%cie_ica_area_script%~ marker = ~"ILDRGDED"~
    source = ~chriz-iwd-encounters/baf/cie_icasaracht_gem.baf~ END
  LAF cie_write_script_blocks STR_VAR script = ~ILDRGDED~ marker = ~CutSceneId(~
    source = ~chriz-iwd-encounters/baf/cie_icasaracht_ending.baf~ END
END

// The second underpriestess (SCS's copy DWSARU0) gets the random items of the first
// (SARUNPR) that it lacks; both lose their five attacks per round (a typo) for one.
DEFINE_ACTION_FUNCTION cie_icasaracht_underpriestesses BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~sarunpr.cre~ AND FILE_EXISTS_IN_GAME ~dwsaru0.cre~ BEGIN
    ACTION_CLEAR_ARRAY cie_ica_rnd
    COPY_EXISTING ~sarunpr.cre~ ~override~
      READ_LONG 0x2bc items
      READ_LONG 0x2c0 count
      FOR (i = 0; i < count; ++i) BEGIN
        READ_ASCII (items + 0x14 * i) item (8) NULL
        TO_UPPER item
        PATCH_IF ((~%item%~ STRING_CONTAINS_REGEXP ~^DW#RND~) = 0) BEGIN
          SPRINT $cie_ica_rnd(~%item%~) ~1~
        END
      END
    BUT_ONLY
    OUTER_SET cie_ica_added = 0
    OUTER_SPRINT cie_ica_items ~~
    ACTION_PHP_EACH cie_ica_rnd AS item => unused BEGIN
      OUTER_SPRINT cie_ica_items ~%cie_ica_items% %item%~
      COPY_EXISTING ~dwsaru0.cre~ ~override~
        PATCH_IF (FILE_EXISTS_IN_GAME ~%item%.itm~) BEGIN
          REMOVE_CRE_ITEM ~%item%~
          ADD_CRE_ITEM ~%item%~ #0 #0 #0 ~NONE~ ~INV~
          SET cie_ica_added += 1
        END ELSE BEGIN
          PATCH_PRINT ~chriz-iwd-encounters: the external random item %item%.itm is absent.~
        END
      BUT_ONLY
    END
    PRINT ~chriz-iwd-encounters: DWSARU0 got %cie_ica_added% random item(s) of SARUNPR (%cie_ica_items% ).~
  END ELSE BEGIN
    PRINT ~chriz-iwd-encounters: SARUNPR or DWSARU0 is absent; there is no replacement priestess to equip.~
  END
  ACTION_FOR_EACH cre IN ~sarunpr~ ~dwsaru0~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cre%.cre~ BEGIN
      COPY_EXISTING ~%cre%.cre~ ~override~
        WRITE_BYTE 0x53 1
      BUT_ONLY
    END
  END
END
