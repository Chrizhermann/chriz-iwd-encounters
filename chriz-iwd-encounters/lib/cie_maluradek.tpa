// Component 400: Lord Maluradek's floor (AR9712, Trials of the Luremaster), designed with
// Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - His banishments work: a party member he sends to room 1 or 2 now raises that room's
//     alarm (TELEPORT_1, TELEPORT_2), as room 3 already did, so its four animated plates
//     appear; only the plates themselves set it before, and they appear only once it is
//     set. The plates fight (they had no combat script).
//   - 350 hit points (base game 250).
//   - Below half his hit points at the latest, all three rooms raise their alarm: the
//     plates come, and he fights in melee between his spells.
//   - Repairs: the first beholder holds still during the dance again (SCS's beholder
//     script ran before the dance hold); his immunity gloves (CIIGEN) sat in a quick slot,
//     where they do nothing, and are worn now.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_maluradek BEGIN
  LAF cie_encounter_actors STR_VAR area = ~ar9712~ END
  // his placement's scripts; the one that banishes (INNATE_CRYPT_THING_TELEPORT)
  OUTER_SPRINT cie_mal_script ~~
  ACTION_CLEAR_ARRAY cie_mal_scripts
  COPY_EXISTING ~ar9712.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      PATCH_IF (~%cre%~ STRING_EQUAL ~LORDM~) BEGIN
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (FILE_EXISTS_IN_GAME ~%script%.bcs~) BEGIN
            SPRINT $cie_mal_scripts(~%script%~) ~1~
          END
        END
      END
    END
  BUT_ONLY
  ACTION_PHP_EACH cie_mal_scripts AS script => unused BEGIN
    COPY_EXISTING ~%script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~INNATE_CRYPT_THING_TELEPORT~) >= 0)
            AND (~%cie_mal_script%~ STRING_EQUAL ~~) BEGIN
          SPRINT cie_mal_script ~%script%~
        END
      END
    BUT_ONLY
  END

  ACTION_IF (~%cie_mal_script%~ STRING_EQUAL ~~) BEGIN
    OUTER_SPRINT cie_mal_script ~CIEMALAI~
    LAF cie_ensure_script STR_VAR script = ~CIEMALAI~ END
    COPY_EXISTING ~ar9712.are~ ~override~
      GET_OFFSET_ARRAY actors ARE_V10_ACTORS
      PHP_EACH actors AS index => actor BEGIN
        READ_ASCII (actor + 0x80) cre (8) NULL
        PATCH_IF (~%cre%~ STRING_EQUAL_CASE ~LORDM~) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + 0x58) RET previous = script END
          PATCH_IF (~%previous%~ STRING_COMPARE ~~) AND FILE_EXISTS_IN_GAME ~%previous%.bcs~ BEGIN
            INNER_ACTION BEGIN COPY_EXISTING ~%previous%.bcs~ ~override/CIEMALAI.bcs~ END
          END
          WRITE_ASCII (actor + 0x58) ~CIEMALAI~ (8)
        END
      END
    BUT_ONLY
  END
  LAF cie_write_script_blocks STR_VAR script = EVAL ~%cie_mal_script%~ marker = ~"TELEPORT_SET"~
    source = ~chriz-iwd-encounters/baf/cie_maluradek_rooms.baf~ END
  EXTEND_TOP ~%cie_mal_script%.bcs~ ~chriz-iwd-encounters/baf/cie_maluradek_alarm.baf~

  // 350 hit points; his immunity item CIIGEN (gloves) from a quick slot, where an item
  // does nothing (lab: he could be paralysed), into his empty gloves slot
  ACTION_IF FILE_EXISTS_IN_GAME ~lordm.cre~ BEGIN
    OUTER_SET cie_mal_gloves = 0
    COPY_EXISTING ~lordm.cre~ ~override~
      LPF cie_raise_creature INT_VAR hp = 350 RET old_hp old_apr old_thac0 END
      REMOVE_CRE_ITEM ~CIIGEN~
      ADD_CRE_ITEM ~CIIGEN~ #0 #0 #0 ~NONE~ ~GLOVES~ EQUIP
      SET cie_mal_gloves = 1
    BUT_ONLY
    PRINT ~chriz-iwd-encounters: Lord Maluradek has %old_hp% -> 350 hit points; his CIIGEN in the gloves slot: %cie_mal_gloves%.~
  END

  LAF cie_maluradek_plates END
  LAF cie_maluradek_beholder END
  LAF cie_placed_stats INT_VAR hp = 350 gloves = 1 STR_VAR area = ~ar9712~ creature = ~lordm~ END
END

// The animated plates get a melee script in a free general or default slot: SCS's
// (DWMESSGE) when SCS is there, else the base game's EFATKMEL.
DEFINE_ACTION_FUNCTION cie_maluradek_plates BEGIN
  OUTER_SPRINT cie_mal_melee ~CIEMEL~
  COPY ~chriz-iwd-encounters/baf/cie_melee.baf~ ~override/CIEMEL.bcs~ COMPILE_BAF_TO_BCS
  ACTION_IF FILE_EXISTS_IN_GAME ~dwmessge.bcs~ BEGIN
    OUTER_SPRINT cie_mal_melee ~DWMESSGE~
  END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~efatkmel.bcs~ BEGIN
    OUTER_SPRINT cie_mal_melee ~EFATKMEL~
  END
  OUTER_SET cie_plate = 0
  ACTION_FOR_EACH plate IN ~keanimph~ ~keanimp2~ BEGIN
    OUTER_SET cie_plate += 1
    ACTION_IF FILE_EXISTS_IN_GAME ~%plate%.cre~ BEGIN
      COPY_EXISTING ~%plate%.cre~ ~override~
        LPF cie_read_script_slot INT_VAR offset = 0x260 RET previous = script END
        PATCH_IF (~%previous%~ STRING_COMPARE ~~) AND (~%previous%~ STRING_COMPARE ~%cie_mal_melee%~) BEGIN
          INNER_ACTION BEGIN
            LAF cie_join_scripts STR_VAR first = ~CIEMEL~ second = EVAL ~%previous%~ target = EVAL ~CIEMPL%cie_plate%~ END
          END
          WRITE_ASCIIE 0x260 ~CIEMPL%cie_plate%~ (8)
        END ELSE BEGIN WRITE_ASCIIE 0x260 ~%cie_mal_melee%~ (8) END
      BUT_ONLY
    END ELSE BEGIN
      PRINT ~chriz-iwd-encounters: %plate%.cre is absent.~
    END
  END
END

// The first beholder: its dance script (KEBEHLDD, which holds it still until the dance
// ends) runs before SCS's beholder script (KEBEHLD1) again; SCS put KEBEHLD1 in a slot
// that runs first. The two slots swap their scripts.
DEFINE_ACTION_FUNCTION cie_maluradek_beholder BEGIN
  COPY ~chriz-iwd-encounters/baf/cie_maluradek_dance.baf~ ~override/CIEMALBH.bcs~ COMPILE_BAF_TO_BCS
  COPY_EXISTING ~ar9712.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII actor name (32) NULL
      READ_ASCII (actor + 0x80) cre (8) NULL
      PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Beholder_1~) OR (~%cre%~ STRING_EQUAL_CASE ~KEBEHLD1~) BEGIN
        LPF cie_read_script_slot INT_VAR offset = (actor + 0x50) RET previous = script END
        PATCH_IF (~%previous%~ STRING_COMPARE ~~) AND (~%previous%~ STRING_COMPARE ~KEBEHLDD~)
            AND (~%previous%~ STRING_COMPARE ~CIEMALBH~) AND FILE_EXISTS_IN_GAME ~%previous%.bcs~ BEGIN
          INNER_ACTION BEGIN
            LAF cie_join_scripts STR_VAR first = ~CIEMALBH~ second = EVAL ~%previous%~ target = ~CIEMALBH~ END
          END
        END
        WRITE_ASCII (actor + 0x50) ~CIEMALBH~ (8)
        FOR (s = 0x58; s < 0x80; s += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + s) RET old = script END
          PATCH_IF (~%old%~ STRING_EQUAL ~KEBEHLDD~) BEGIN WRITE_ASCII (actor + s) ~~ (8) END
        END
      END
    END
  BUT_ONLY
END
