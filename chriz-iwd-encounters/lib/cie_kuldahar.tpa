// Component 320: the orog raid on Kuldahar after Yxunomei's death (AR2100), designed
// with Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - The raid moves as one: once a raider or defender has woken (the party came
//     close or attacked), every Neo-Orog Avenger wakes and the orogs come for the
//     party. The town's defenders keep the base game's rule.
//   - The three Neo-Orog Marauders, the raid's leaders, come as a second wave: three
//     rounds after the raid woke, a war horn sounds and they charge (a Marauder the
//     party reaches or attacks first fights at once, as in the base game).
//   - The leaders are a bit stronger (70 hit points, two attacks per round, THAC0
//     10); the Avengers have 45 hit points.
//   - Repairs: the orogs fight back against the town's defenders; raiders and
//     defenders that never woke leave four days after the raid's first visit, like
//     the woken ones; the town alarm no longer brings a second, living Arundel out
//     while he is dying upstairs.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_kuldahar BEGIN
  LAF cie_area_script STR_VAR area = ~ar2100~ fallback = ~ar2100~ RET cie_kul_area_script = script END
  // the raid's creatures and their scripts, from the area script's spawn block
  // (the block that waits for Yxunomei's death)
  LAM cie_kuldahar_raid
    LAF cie_kuldahar_stats END
    LAF cie_kuldahar_wake END
    LAF cie_kuldahar_orogs END
    LAF cie_kuldahar_area END
END

// The raid: the creatures that the block on SPRITE_IS_DEADYXUNOMEI and
// #spawn_group_1 creates. Raiders are those whose default script is the orogs'
// KUATKORO; Marauders the raiders with the most XP (the base game: KAOROGE, 420
// XP, against KAOROG, 270). Their "asleep" and "awake" scripts are read from the
// raiders' creature files (base game: KUATKEFF, KUATKREM in KUATKEFF's wake block).
// A macro: its results (cie_kul_found, the scripts, the raider lists) are for the
// caller's next steps.
DEFINE_ACTION_MACRO cie_kuldahar_raid BEGIN
  // These are the decided raid roles, independent of XP or existing script slots.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cie_kul_raider BEGIN ~KAOROG~ => 1 ~KAOROGE~ => 1 END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cie_kul_avenger BEGIN ~KAOROG~ => 1 END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cie_kul_marauder BEGIN ~KAOROGE~ => 1 END
  OUTER_SPRINT cie_kul_sleep ~KUATKEFF~
  OUTER_SPRINT cie_kul_awake ~KUATKREM~
  OUTER_SPRINT cie_kul_orog_ai ~KUATKORO~
  ACTION_FOR_EACH script IN ~kuatkeff~ ~kuatkrem~ ~kuatkoro~ BEGIN
    ACTION_IF !FILE_EXISTS_IN_GAME ~%script%.bcs~ BEGIN
      COPY ~chriz-iwd-encounters/baf/cie_%script%.baf~ ~override/%script%.bcs~ COMPILE_BAF_TO_BCS
    END
  END
  LAF cie_write_script_blocks STR_VAR script = EVAL ~%cie_kul_area_script%~
    marker = ~"#spawn_group_1"~ source = ~chriz-iwd-encounters/baf/cie_kuldahar_spawn.baf~ END
END

// Avengers 45 hit points; Marauders 70, two attacks per round and THAC0 10.
// These fields belong to the raid.
DEFINE_ACTION_FUNCTION cie_kuldahar_stats BEGIN
  ACTION_PHP_EACH cie_kul_avenger AS cre => unused BEGIN
    COPY_EXISTING ~%cre%.cre~ ~override~
      LPF cie_raise_creature INT_VAR hp = 45 RET old_hp old_apr old_thac0 END
    PRINT ~chriz-iwd-encounters: the raid's %cre% has %old_hp% -> 45 hit points.~
  END
  ACTION_PHP_EACH cie_kul_marauder AS cre => unused BEGIN
    COPY_EXISTING ~%cre%.cre~ ~override~
      LPF cie_raise_creature INT_VAR hp = 70 apr = 2 thac0 = 10 RET old_hp old_apr old_thac0 END
    PRINT ~chriz-iwd-encounters: the raid's leader %cre% has %old_hp% -> 70 hit points, %old_apr% -> 2 attacks, THAC0 %old_thac0% -> 10.~
  END
END

// Waking: raiders and defenders share the asleep script. The Avengers get a copy
// (CIEKULAV) that also wakes them when the raid is awake (CIE_KUL_ALERT), the
// Marauders one (CIEKULMA) that wakes them with the war horn (CIE_KUL_WAVE 2). The
// defenders keep the shared script: in the lab a defender far from the party never
// ran it (the alert was set, its conditions held, it stayed asleep), while far
// Avengers did. All three leave, if still asleep, four days after the raid's first
// visit. The awake script raises the alert.
DEFINE_ACTION_FUNCTION cie_kuldahar_wake BEGIN
  OUTER_SPRINT cie_kul_who ~Avengers~
  OUTER_SPRINT cie_kul_copy ~CIEKULAV~
  OUTER_SPRINT cie_kul_wake ~!Global("CIE_KUL_ALERT","MYAREA",0)~
  OUTER_SPRINT cie_kul_wake_reason ~the raid is awake (CIE_KUL_ALERT, set by the first raider or defender that wakes)~
  COPY_EXISTING ~%cie_kul_sleep%.bcs~ ~override/CIEKULAV.bcs~
  EXTEND_TOP ~CIEKULAV.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_wake.baf~ EVALUATE_BUFFER
  OUTER_SPRINT cie_kul_who ~Marauders~
  OUTER_SPRINT cie_kul_copy ~CIEKULMA~
  OUTER_SPRINT cie_kul_wake ~Global("CIE_KUL_WAVE","MYAREA",2)~
  OUTER_SPRINT cie_kul_wake_reason ~the war horn sounds (CIE_KUL_WAVE 2)~
  COPY_EXISTING ~%cie_kul_sleep%.bcs~ ~override/CIEKULMA.bcs~
  EXTEND_TOP ~CIEKULMA.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_wake.baf~ EVALUATE_BUFFER
  ACTION_FOR_EACH script IN ~%cie_kul_sleep%~ ~CIEKULAV~ ~CIEKULMA~ BEGIN
    EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_cleanup.baf~
  END
  OUTER_SET cie_kul_awakened = 0
  ACTION_PHP_EACH cie_kul_raider AS cre => unused BEGIN
    OUTER_SPRINT copy ~CIEKULAV~
    ACTION_IF VARIABLE_IS_SET $cie_kul_marauder(~%cre%~) BEGIN
      OUTER_SPRINT copy ~CIEKULMA~
    END
    COPY_EXISTING ~%cre%.cre~ ~override~
      LPF cie_read_script_slot INT_VAR offset = 0x260 RET script END
      WRITE_ASCIIE 0x260 ~%copy%~ (8)
      WRITE_ASCII 0x268 ~KUATKORO~ (8)
      SET cie_kul_awakened += 1
    BUT_ONLY
  END
  EXTEND_TOP ~%cie_kul_awake%.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_alert.baf~
  PRINT ~chriz-iwd-encounters: the raid's orogs wake as one (%cie_kul_awakened% creature files: Avengers CIEKULAV with the alert, leaders CIEKULMA with the war horn); %cie_kul_sleep% and both copies send the unwoken away after four days.~
END

// The orogs, once awake: they fight back against the town's defenders (who attack
// them on sight but are not their enemies), and walk to the party when they see
// no enemy.
DEFINE_ACTION_FUNCTION cie_kuldahar_orogs BEGIN
  COPY_EXISTING ~%cie_kul_orog_ai%.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF cie_remove_baf_blocks STR_VAR text = ~AttackedBy([NEUTRAL],DEFAULT)~ RET removed END
      LPF cie_remove_baf_blocks STR_VAR text = ~MoveToObject(Player1)~ RET removed END
    END
  BUT_ONLY
  EXTEND_BOTTOM ~%cie_kul_orog_ai%.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_orog.baf~
  PRINT ~chriz-iwd-encounters: the orogs fight back against the defenders and come for the party (%cie_kul_orog_ai%).~
END

// The area: three rounds after the raid woke, the war horn (CIE_KUL_WAVE 1 waiting,
// 2 sounded). The town alarm's Arundel only comes while Yxunomei lives.
DEFINE_ACTION_FUNCTION cie_kuldahar_area BEGIN
  EXTEND_TOP ~%cie_kul_area_script%.bcs~ ~chriz-iwd-encounters/baf/cie_kuldahar_area.baf~
  LAF cie_write_script_blocks STR_VAR script = EVAL ~%cie_kul_area_script%~
    marker = ~"#spawn_group_0"~ source = ~chriz-iwd-encounters/baf/cie_kuldahar_town_alarm.baf~ END
END
