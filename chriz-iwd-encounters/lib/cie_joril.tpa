// Component 330: Joril's throne room in Wyrm's Tooth (AR7004), designed with
// Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - Joril has 185 hit points (base game 145).
//   - Joril, his bodyguards and his guards use the Berserker rage of the kit SCS
//     gives them (SCS's melee AI for IWD never does); without SCS they have no kit
//     and fight as before.
//   - His bodyguards cast their memorised Hold Person (no script of theirs did).
//   - When Gorg turns hostile, his wolf pack turns with him and comes to him.
//   - Repair: the peaceful handover of Joril's badge no longer pays its experience
//     twice.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_joril BEGIN
  OUTER_SPRINT cie_jor_area_script ~~
  COPY_EXISTING ~ar7004.are~ ~override~
    READ_ASCII 0x94 cie_jor_area_script (8) NULL
  BUT_ONLY
  ACTION_IF (~%cie_jor_area_script%~ STRING_EQUAL ~~) OR (~%cie_jor_area_script%~ STRING_EQUAL_CASE ~NONE~)
      OR (!FILE_EXISTS_IN_GAME ~%cie_jor_area_script%.bcs~) BEGIN
    FAIL ~chriz-iwd-encounters: ar7004.are has no area script.~
  END
  // the court's scripts: what Joril's, his bodyguards' and his guards' placements run
  // (base game: WTGIANT1), leaving out the base game's difficulty script and teams;
  // Gorg's script; the placed wolves of his pack by script name
  ACTION_CLEAR_ARRAY cie_jor_court
  OUTER_SPRINT cie_jor_gorg ~~
  OUTER_SPRINT cie_jor_pack ~~
  OUTER_SET cie_jor_wolves = 0
  COPY_EXISTING ~ar7004.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      READ_LONG (actor + 0x28) flags
      READ_ASCII actor name (32) NULL
      PATCH_IF (~%cre%~ STRING_EQUAL ~JORIL~) OR (~%cre%~ STRING_EQUAL ~GIANTFS~) OR (~%cre%~ STRING_EQUAL ~GIANTFG~) BEGIN
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (~%script%~ STRING_COMPARE ~EFDELDEF~)
              AND ((~%script%~ STRING_CONTAINS_REGEXP ~^GNTEAM~) != 0) BEGIN
            SPRINT $cie_jor_court(~%script%~) ~1~
          END
        END
      END
      PATCH_IF (~%cre%~ STRING_EQUAL ~GORG~) BEGIN
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (~%cie_jor_gorg%~ STRING_EQUAL ~~) BEGIN
            SPRINT cie_jor_gorg ~%script%~
          END
        END
      END
      PATCH_IF (~%cre%~ STRING_EQUAL ~WINWOLFP~) AND (flags BAND 8) BEGIN
        INNER_PATCH_SAVE name ~%name%~ BEGIN
          REPLACE_TEXTUALLY ~ ~ ~~
        END
        SET cie_jor_wolves += 1
        SPRINT cie_jor_pack ~%cie_jor_pack%
    ActionOverride("%name%",Enemy())
    ActionOverride("%name%",MoveToObject("Gorg"))~
      END
    END
  BUT_ONLY

  LAF cie_joril_hit_points END
  LAF cie_joril_court END
  LAF cie_joril_gorg END
  LAF cie_joril_badge END
END

// Joril's hit points: 185, never lower than what he has.
DEFINE_ACTION_FUNCTION cie_joril_hit_points BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~joril.cre~ BEGIN
    COPY_EXISTING ~joril.cre~ ~override~
      LPF cie_raise_creature INT_VAR hp = 185 RET old_hp old_apr old_thac0 END
    PRINT ~chriz-iwd-encounters: Joril has %old_hp% -> 185 hit points.~
  END
END

// On top of the court's scripts: Hold Person for whoever has it memorised (his
// bodyguards), the Berserker rage for Berserkers (SCS's kit for Joril, his
// bodyguards and his guards), once each.
DEFINE_ACTION_FUNCTION cie_joril_court BEGIN
  OUTER_SET cie_jor_scripts = 0
  ACTION_PHP_EACH cie_jor_court AS script => unused BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%script%.bcs~ BEGIN
      EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_joril_court.baf~
      OUTER_SET cie_jor_scripts += 1
    END
  END
  ACTION_IF (cie_jor_scripts = 0) BEGIN
    WARN ~chriz-iwd-encounters: Joril's court runs no script this component knows; it fights as before.~
  END ELSE BEGIN
    PRINT ~chriz-iwd-encounters: Joril's court uses Hold Person and the Berserker rage (%cie_jor_scripts% script).~
  END
END

// Gorg: once he is hostile his script sets his pack's group variable
// (MAP_GROUP_HOSTILE1, which his base script answers to) and CIE_JOR_GORG; the area
// script then sends the placed wolves of the pack to him.
DEFINE_ACTION_FUNCTION cie_joril_gorg BEGIN
  OUTER_SET cie_jor_pack_var = 0
  ACTION_IF (~%cie_jor_gorg%~ STRING_COMPARE ~~) AND FILE_EXISTS_IN_GAME ~%cie_jor_gorg%.bcs~ BEGIN
    COPY_EXISTING ~%cie_jor_gorg%.bcs~ ~override~
      PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"MYAREAMAP_GROUP_HOSTILE1"~) >= 0) BEGIN
        SET cie_jor_pack_var = 1
      END
    BUT_ONLY
  END
  ACTION_IF (cie_jor_pack_var = 0) OR (cie_jor_wolves = 0) BEGIN
    WARN ~chriz-iwd-encounters: Gorg's pack stays as it is (Gorg's script "%cie_jor_gorg%" answers to MAP_GROUP_HOSTILE1: %cie_jor_pack_var%; wolves placed by name: %cie_jor_wolves%).~
  END ELSE BEGIN
    EXTEND_TOP ~%cie_jor_gorg%.bcs~ ~chriz-iwd-encounters/baf/cie_joril_gorg.baf~
    EXTEND_TOP ~%cie_jor_area_script%.bcs~ ~chriz-iwd-encounters/baf/cie_joril_pack.baf~ EVALUATE_BUFFER
    PRINT ~chriz-iwd-encounters: when Gorg turns hostile, his pack (%cie_jor_wolves% wolves) turns with him and comes to him.~
  END
END

// The badge: the area script pays "Level_10_AVERAGE" when the party has Joril's
// badge; the peaceful handover in his dialogue (DJORIL, Got_Joril_Badge 1) has
// already paid the same. The payment moves into its own block that also needs
// Got_Joril_Badge 0; the badge block keeps the rest.
DEFINE_ACTION_FUNCTION cie_joril_badge BEGIN
  OUTER_SPRINT cie_jor_xp ~~
  COPY_EXISTING ~%cie_jor_area_script%.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      SET at = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~Global("JORIL_BADGE","GLOBAL",0)~)
      PATCH_IF (at >= 0) BEGIN
        SET start = RINDEX_BUFFER (CASE_SENSITIVE EVALUATE_REGEXP ~^IF~ at)
        SET end = INDEX_BUFFER (CASE_SENSITIVE EVALUATE_REGEXP ~^END~ at)
        PATCH_IF (start >= 0) AND (end > start) BEGIN
          READ_ASCII start block (end - start)
          PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~PartyHasItem("JORIL")~ ~%block%~) >= 0) BEGIN
            INNER_PATCH_SAVE block ~%block%~ BEGIN
              REPLACE_EVALUATE CASE_INSENSITIVE ~[%TAB% ]*AddXP2DA("\([^"]+\)")[%TAB% ]*[%MNL%]?[%LNL%]~ BEGIN
                SPRINT cie_jor_xp ~%MATCH1%~
              END ~~
            END
            DELETE_BYTES start (end - start)
            INSERT_BYTES start (STRING_LENGTH ~%block%~)
            WRITE_ASCIIE start ~%block%~
          END
        END
      END
    END
  BUT_ONLY
  ACTION_IF (~%cie_jor_xp%~ STRING_EQUAL ~~) BEGIN
    WARN ~chriz-iwd-encounters: found no experience payment in %cie_jor_area_script%.bcs's badge block; it stays as it is.~
  END ELSE BEGIN
    EXTEND_TOP ~%cie_jor_area_script%.bcs~ ~chriz-iwd-encounters/baf/cie_joril_badge.baf~ EVALUATE_BUFFER
    PRINT ~chriz-iwd-encounters: Joril's badge pays %cie_jor_xp% only when he did not hand it over himself.~
  END
END
