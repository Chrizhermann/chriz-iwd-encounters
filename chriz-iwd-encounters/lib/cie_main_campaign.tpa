  LAF cie420_create_elite INT_VAR tra_id = 4211 xp = 13000 hp = 76 ac = 1 thac0 = 12 apr = 1 lvl1 = 12 class_id = 1 race_id = 2 anim_override = 0x6221
    STR_VAR target = ~CIE411~ donor = ~DWSDEL0~ fallback = ~SDELFWZ1~ look = ~SDELFWZ1~ s_def = ~CIE411~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~cie411.cre~ BEGIN
    COPY_EXISTING ~cie411.cre~ ~override~
      LPF cie420_ensure_item STR_VAR item = ~STAF02~ slot = ~WEAPON1~ equip = ~EQUIP~ END
      LPF cie420_ensure_item INT_VAR q1 = 2 STR_VAR item = ~POTN52~ slot = ~QITEM1~ END
      LPF cie420_ensure_spell INT_VAR lvl = 1 cnt = 3 STR_VAR spell = ~SPWI112~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 2 cnt = 2 STR_VAR spell = ~SPWI212~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 3 cnt = 2 STR_VAR spell = ~SPWI302~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPWI401~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 4 cnt = 2 STR_VAR spell = ~SPWI408~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPWI412~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 5 cnt = 1 STR_VAR spell = ~SPWI508~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 5 cnt = 1 STR_VAR spell = ~SPWI513~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 5 cnt = 1 STR_VAR spell = ~SPWI523~ stype = ~wizard~ END
      LPF cie420_ensure_spell INT_VAR lvl = 6 cnt = 1 STR_VAR spell = ~SPWI605~ stype = ~wizard~ END
    BUT_ONLY
