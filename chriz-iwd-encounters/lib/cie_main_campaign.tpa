      LPF cie420_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR421~ stype = ~priest~ END
      LPF cie420_ensure_spell INT_VAR lvl = 5 cnt = 1 STR_VAR spell = ~SPPR503~ stype = ~priest~ END
