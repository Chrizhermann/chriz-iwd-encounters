  // Disable any legacy v0.3.0/v0.3.1 squad names if present on a pre-existing save/fixture
  ACTION_FOR_EACH spec IN
    ~ar4002=>CIE401 Vanguard~ ~ar4002=>CIE402 Venom Archer~ ~ar4002=>CIE403 Stormcaller~ ~ar4002=>CIE404 War-Mage~
    ~ar5104=>CIE410 Blade-Captain~ ~ar5104=>CIE411 High Battlemage~ ~ar5104=>CIE412 Deadeye Sniper~
    ~ar5104=>CIE413 Hierophant~ ~ar5104=>CIE414 Shadowblade~ ~ar5104=>CIE415 Ward-Guard~
    ~ar6003=>CIE417 Orog War-Shaman~ ~ar6003=>CIE418 Orog Skullsplitter~
    ~ar7004=>CIE420 Frostblade Champ~ ~ar7004=>CIE422 Icebow Stalker~
    ~ar8007=>CIE425 Kraken Archmage~ ~ar8007=>CIE426 Kraken Enforcer~
    ~ar8007=>CIE427 Deep Inquisitor~ ~ar8007=>CIE428 Nightblade~ ~ar8007=>CIE429 Marksman~
  BEGIN
    OUTER_PATCH ~%spec%~ BEGIN
      REPLACE_EVALUATE ~^\([^=]+\)=>\(.+\)$~ BEGIN
        SPRINT rem_are ~%MATCH1%~
        SPRINT rem_nam ~%MATCH2%~
      END ~~
    END
    ACTION_IF FILE_EXISTS_IN_GAME ~%rem_are%.are~ BEGIN
      COPY_EXISTING ~%rem_are%.are~ ~override~
        LPF cie_disable_actor_by_name STR_VAR match_name = EVAL ~%rem_nam%~ END
      BUT_ONLY
    END
  END

  ACTION_FOR_EACH area IN ~ar4002~ ~ar5104~ ~ar5403~ ~ar6003~ ~ar7004~ ~ar8007~ BEGIN
    LAF cie_place_area_actors STR_VAR folder = ~actors_420~ area END
  END
END

DEFINE_ACTION_FUNCTION cie_main_campaign BEGIN
  LAF cie420_repair_tarnsen END
  LAF cie420_repair_dgina2 END
  LAF cie420_kresselack_waves END
  LAF cie420_terikan END
  LAF cie_main_disable_fillers END
  LAF cie420_upgrade_regulars END
  LAF cie420_fix_quests_and_spawns END
  LAF cie420_upgrade_kaylessa END
  LAF cie420_build_squads END
  PRINT ~chriz-iwd-encounters: Main campaign overhaul applied (Tarnsen, DGINA2, DKAYLESS/DEGENIA, Kaylessa, AR3301.INI, AR3503 3-wave crypt, Terikan, Ch.2-6 thinning, Severed Hand/Giant/Wyrm upgrades, and 6 asymmetric lore-grounded squads).~
END

// 9. Hotpatch component 425: idempotent repair for v0.3.0-v0.3.2 quest counters & AR4002/AR5403 squad flags.
DEFINE_ACTION_FUNCTION cie_quest_counter_hotfix BEGIN
  LAF cie420_repair_quest_counters END

  OUTER_SET has_ar4002_squad = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~ar4002.are~ BEGIN
    COPY_EXISTING ~ar4002.are~ ~override~
      GET_OFFSET_ARRAY actors ARE_V10_ACTORS
      PHP_EACH actors AS idx => actor BEGIN
        READ_ASCII (actor + 0x80) cre (8) NULL
        PATCH_IF (~%cre%~ STRING_EQUAL_CASE ~CIE401~)
              OR (~%cre%~ STRING_EQUAL_CASE ~CIE402~)
              OR (~%cre%~ STRING_EQUAL_CASE ~CIE403~) BEGIN
          SET has_ar4002_squad = 1
          READ_LONG (actor + 0x28) fl
          PATCH_IF ((fl BAND 8) != 0) BEGIN
            WRITE_LONG (actor + 0x28) (fl BAND (BNOT 8))
          END
        END
      END
    BUT_ONLY
  END
  ACTION_IF has_ar4002_squad BEGIN
    ACTION_FOR_EACH c IN ~cie401~ ~cie402~ ~cie403~ BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%c%.cre~ BEGIN
        COPY_EXISTING ~%c%.cre~ ~override~
          PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
            WRITE_ASCIIE 0x280 ~Talonite~ #32
          END
        BUT_ONLY
      END
    END
  END

  OUTER_SET has_ar5403_squad = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~ar5403.are~ BEGIN
    COPY_EXISTING ~ar5403.are~ ~override~
      GET_OFFSET_ARRAY actors ARE_V10_ACTORS
      PHP_EACH actors AS idx => actor BEGIN
        READ_ASCII (actor + 0x80) cre (8) NULL
        PATCH_IF (~%cre%~ STRING_EQUAL_CASE ~CIE413~)
              OR (~%cre%~ STRING_EQUAL_CASE ~CIE414~) BEGIN
          SET has_ar5403_squad = 1
          READ_LONG (actor + 0x28) fl
          PATCH_IF ((fl BAND 8) != 0) BEGIN
            WRITE_LONG (actor + 0x28) (fl BAND (BNOT 8))
          END
        END
      END
    BUT_ONLY
  END
  ACTION_IF has_ar5403_squad BEGIN
    ACTION_FOR_EACH c IN ~cie413~ ~cie414~ BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%c%.cre~ BEGIN
        COPY_EXISTING ~%c%.cre~ ~override~
          PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
            WRITE_ASCIIE 0x280 ~ELVEN_SOLDIER~ #32
          END
        BUT_ONLY
      END
    END
  END
  PRINT ~chriz-iwd-encounters: Quest kill counters repaired (DKAYLESS >11, Talonite >6/<7, AR4002/AR5403 quest-DV flags preserved).~
END
