  LAF cie420_create_elite INT_VAR tra_id = 4212 xp = 12500 hp = 88 ac = (0 - 1) thac0 = 8 apr = 1 lvl1 = 10 lvl2 = 11 class_id = 14 race_id = 2 anim_override = 0x6021
    STR_VAR target = ~CIE412~ donor = ~PRESIO~ fallback = ~DROWPM~ look = ~SDELFCL~ s_def = ~CIE4CM1~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~cie412.cre~ BEGIN
    COPY_EXISTING ~cie412.cre~ ~override~
      LPF cie420_ensure_item STR_VAR item = ~HELM01~ slot = ~HELMET~ END
      LPF cie420_ensure_item STR_VAR item = ~STAF02~ slot = ~WEAPON1~ equip = ~EQUIP~ END
      LPF cie420_ensure_item INT_VAR q1 = 2 STR_VAR item = ~POTN52~ slot = ~QITEM1~ END
      LPF cie420_ensure_spell INT_VAR lvl = 2 cnt = 1 STR_VAR spell = ~SPPR214~ stype = ~priest~ END
      LPF cie420_ensure_spell INT_VAR lvl = 3 cnt = 1 STR_VAR spell = ~SPPR316~ stype = ~priest~ END
      LPF cie420_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR401~ stype = ~priest~ END
