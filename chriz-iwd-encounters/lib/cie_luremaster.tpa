// Component 410: the Luremaster (AR9711, the end of Trials of the Luremaster), designed
// with Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - He opens the fight with his Improved Invisibility.
//   - While he has spells and is not beaten, an enemy next to him makes him hop away by
//     Dimension Door to one of the eight points of his old hop circuit, every 12 or 18
//     seconds at most (SCS took his hop script off; the class slot points at a missing
//     NULL.BCS, which now holds this script).
//   - Repairs: his Dispel Magic entry checks the spell he has memorised (it checked
//     Remove Magic, which he does not have, so his three Dispel Magic never came); a
//     fallen spectral hero brings its replacement (the counter the area script waits for
//     was never raised).
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_luremaster BEGIN
  LAF cie_encounter_actors STR_VAR area = ~ar9711~ END
  OUTER_SET cie_lur_points = 8
  OUTER_SET $cie_lur_px(~0~) = 1251
  OUTER_SET $cie_lur_py(~0~) = 269
  OUTER_SET $cie_lur_px(~1~) = 836
  OUTER_SET $cie_lur_py(~1~) = 1023
  OUTER_SET $cie_lur_px(~2~) = 539
  OUTER_SET $cie_lur_py(~2~) = 575
  OUTER_SET $cie_lur_px(~3~) = 1616
  OUTER_SET $cie_lur_py(~3~) = 359
  OUTER_SET $cie_lur_px(~4~) = 1058
  OUTER_SET $cie_lur_py(~4~) = 952
  OUTER_SET $cie_lur_px(~5~) = 1769
  OUTER_SET $cie_lur_py(~5~) = 560
  OUTER_SET $cie_lur_px(~6~) = 1144
  OUTER_SET $cie_lur_py(~6~) = 361
  OUTER_SET $cie_lur_px(~7~) = 604
  OUTER_SET $cie_lur_py(~7~) = 826

  // his placement: the fight form (TRGBARD), its scripts
  OUTER_SET cie_lur_found = 0
  ACTION_CLEAR_ARRAY cie_lur_scripts
  COPY_EXISTING ~ar9711.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      PATCH_IF (~%cre%~ STRING_EQUAL ~TRGBARD~) AND (cie_lur_found = 0) BEGIN
        SET cie_lur_found = 1
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (FILE_EXISTS_IN_GAME ~%script%.bcs~) BEGIN
            SPRINT $cie_lur_scripts(~%script%~) ~1~
          END
        END
      END
    END
  BUT_ONLY

  LAF cie_luremaster_hop END
  LAF cie_luremaster_dispel END
  LAF cie_luremaster_heroes END
END

// The hop script CIELURHP: in place of his old hop circuit DULURWRP where it still runs,
// else in his class slot when that points at a missing script (SCS leaves NULL there),
// else in his first free slot.
DEFINE_ACTION_FUNCTION cie_luremaster_hop BEGIN
    OUTER_SPRINT cie_lur_hops ~~
    OUTER_FOR (k = 0; k < cie_lur_points; ++k) BEGIN
      OUTER_SET x = $cie_lur_px(~%k%~)
      OUTER_SET y = $cie_lur_py(~%k%~)
      OUTER_SET timer = 12 + 6 * (k MODULO 2)
      OUTER_SPRINT cie_lur_hops ~%cie_lur_hops%  RESPONSE #100%LNL%    SetGlobalTimer("CIE_LUR_HOP","LOCALS",%timer%)%LNL%    ForceSpellPoint([%x%.%y%],WIZARD_DIMENSION_DOOR)%LNL%~
    END
    COPY ~chriz-iwd-encounters/baf/cie_luremaster.baf~ ~override/CIELURHP.bcs~
      EVALUATE_BUFFER
      COMPILE_BAF_TO_BCS
    OUTER_SET cie_lur_slotted = 0
    COPY_EXISTING ~ar9711.are~ ~override~
      GET_OFFSET_ARRAY actors ARE_V10_ACTORS
      PHP_EACH actors AS index => actor BEGIN
        READ_ASCII (actor + 0x80) cre (8) NULL
        TO_UPPER cre
        PATCH_IF (~%cre%~ STRING_EQUAL ~TRGBARD~) AND (cie_lur_slotted = 0) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + 0x60) RET previous = script END
          PATCH_IF (~%previous%~ STRING_COMPARE ~~) AND (~%previous%~ STRING_COMPARE ~DULURWRP~)
              AND (~%previous%~ STRING_COMPARE ~CIELURHP~) AND FILE_EXISTS_IN_GAME ~%previous%.bcs~ BEGIN
            INNER_ACTION BEGIN
              LAF cie_join_scripts STR_VAR first = ~CIELURHP~ second = EVAL ~%previous%~ target = ~CIELURHP~ END
            END
          END
          FOR (s = 0x50; s < 0x80; s += 8) BEGIN
            LPF cie_read_script_slot INT_VAR offset = (actor + s) RET old = script END
            PATCH_IF (~%old%~ STRING_EQUAL ~DULURWRP~) BEGIN WRITE_ASCII (actor + s) ~~ (8) END
          END
          WRITE_ASCII (actor + 0x60) ~CIELURHP~ (8)
          SET cie_lur_slotted = 1

        END
      END
    BUT_ONLY
      PRINT ~chriz-iwd-encounters: the Luremaster opens with Improved Invisibility and hops over %cie_lur_points% points when an enemy is next to him (CIELURHP).~
END

// His spell script checks Remove Magic for his Dispel Magic entry. In IWD:EE's SPELL.IDS
// 2302 is Remove Magic (SPWI302, also listed as WIZARD_DISPEL_MAGIC) and his Dispel Magic
// is SPWI323 (2323). Where he memorises SPWI323 and not SPWI302, the entry uses 2323.
DEFINE_ACTION_FUNCTION cie_luremaster_dispel BEGIN
  OUTER_SPRINT cie_lur_entry ~~
  // Locate the owned Dispel entry, not a particular script version. Existing
  // selection conditions and cast targets remain; missing entries get our block.
  ACTION_PHP_EACH cie_lur_scripts AS script => unused BEGIN
    COPY_EXISTING ~%script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        SET at = INDEX_BUFFER (CASE_INSENSITIVE ~\(HaveSpell\|Spell\)(.*WIZARD_\(REMOVE\|DISPEL\)_MAGIC)~)
        SET res_at = INDEX_BUFFER (CASE_INSENSITIVE ~HaveSpellRES("SPWI323")~)
        PATCH_IF (at >= 0) OR (res_at >= 0) BEGIN
          SPRINT cie_lur_entry ~%script%~
        END
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~HaveSpell(WIZARD_\(REMOVE\|DISPEL\)_MAGIC)~ ~HaveSpellRES("SPWI323")~
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~Spell(\(.*\),WIZARD_\(REMOVE\|DISPEL\)_MAGIC)~ ~SpellRES("SPWI323",\1)~
      END
    BUT_ONLY
  END
  ACTION_IF (~%cie_lur_entry%~ STRING_EQUAL ~~) BEGIN
    // The race slot is his spell AI. Preserve a different spell script and put
    // the replacement entry before it, in a copy used by this placement only.
    COPY ~chriz-iwd-encounters/baf/cie_luremaster_dispel.baf~ ~override/CIELURDS.bcs~ COMPILE_BAF_TO_BCS
    COPY_EXISTING ~ar9711.are~ ~override~
      GET_OFFSET_ARRAY actors ARE_V10_ACTORS
      PHP_EACH actors AS index => actor BEGIN
        READ_ASCII (actor + 0x80) cre (8) NULL
        PATCH_IF (~%cre%~ STRING_EQUAL_CASE ~TRGBARD~) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + 0x68) RET previous = script END
          PATCH_IF (~%previous%~ STRING_COMPARE ~~) AND (~%previous%~ STRING_COMPARE ~CIELURDS~) BEGIN
            INNER_ACTION BEGIN
              LAF cie_join_scripts STR_VAR first = ~CIELURDS~ second = EVAL ~%previous%~ target = ~CIELURDS~ END
            END
          END
          WRITE_ASCII (actor + 0x68) ~CIELURDS~ (8)
        END
      END
    BUT_ONLY
  END
END

// The heroes' replacements: the area script spawns one while its counter (the heroes'
// shared death variable, AR9711_HERO) is above 0, and nothing raised it; the engine only
// raises SPRITE_IS_DEAD<that name>. A block on top of the area script turns each new
// death into one replacement (the area script still stops at six).
DEFINE_ACTION_FUNCTION cie_luremaster_heroes BEGIN
  OUTER_SPRINT cie_lur_hero ~AR9711_HERO~
  ACTION_IF FILE_EXISTS_IN_GAME ~trsph1.cre~ BEGIN
    COPY_EXISTING ~trsph1.cre~ ~override~
      READ_ASCII 0x280 cie_lur_hero (32) NULL
      PATCH_IF (~%cie_lur_hero%~ STRING_EQUAL ~~) BEGIN
        SPRINT cie_lur_hero ~AR9711_HERO~
      END
    BUT_ONLY
  END
  LAF cie_area_script STR_VAR area = ~ar9711~ fallback = ~AR9711~ RET cie_lur_area_script = script END
  LAF cie_write_script_blocks STR_VAR script = EVAL ~%cie_lur_area_script%~ marker = ~"#spectral_reinforcements"~
    source = ~chriz-iwd-encounters/baf/cie_luremaster_replacements.baf~ END
  EXTEND_TOP ~%cie_lur_area_script%.bcs~ ~chriz-iwd-encounters/baf/cie_luremaster_heroes.baf~ EVALUATE_BUFFER
END