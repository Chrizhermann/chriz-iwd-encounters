      WRITE_SHORT 0x26 180
      WRITE_SHORT 0x46 (0 - 6)
      WRITE_SHORT 0x48 (0 - 6)
      WRITE_BYTE  0x52 (0 - 1)
      WRITE_BYTE  0x53 3
    BUT_ONLY
  END

