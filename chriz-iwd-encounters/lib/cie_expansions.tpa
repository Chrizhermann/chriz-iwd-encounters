  // 5. Build bespoke expansion champions, casters & monsters (CIE501..CIE533)
  // CIE501: Frost Giant War-Shaman (Fighter/Cleric L15/15 w/ AoE War-Chant Haste & Dispel Magic)
  OUTER_SPRINT fg_shaman_donor ~jklshm~
  ACTION_IF FILE_EXISTS_IN_GAME ~mytos.cre~ BEGIN OUTER_SPRINT fg_shaman_donor ~mytos~ END
  COPY_EXISTING ~%fg_shaman_donor%.cre~ ~override/cie501.cre~
    LPF cie500_set_core INT_VAR name_tra = 501 xp = 30000 hp = 190 ac = 0 - 6 thac0 = 0 apr = 8 rcld = 100 mr = 20 lvl1 = 15 lvl2 = 15 STR_VAR s_ovr = ~CIE5GSHM~ s_cls = ~CIE5FC1~ END
    WRITE_BYTE 0x273 8 // FIGHTER_CLERIC
    SAY NAME1 @501
    SAY NAME2 @501
    REMOVE_KNOWN_SPELLS
    REMOVE_MEMORIZED_SPELLS
    LPF cie_ensure_spell INT_VAR lvl = 1 cnt = 1 STR_VAR spell = ~SPPR101~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 2 cnt = 2 STR_VAR spell = ~SPPR214~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 3 cnt = 2 STR_VAR spell = ~SPPR303~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 3 cnt = 1 STR_VAR spell = ~SPPR316~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR401~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR403~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR406~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 4 cnt = 1 STR_VAR spell = ~SPPR421~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 5 cnt = 2 STR_VAR spell = ~SPPR503~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 5 cnt = 1 STR_VAR spell = ~SPPR513~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 6 cnt = 1 STR_VAR spell = ~SPPR603~ stype = ~priest~ END
    LPF cie_ensure_spell INT_VAR lvl = 6 cnt = 1 STR_VAR spell = ~SPPR607~ stype = ~priest~ END
    ADD_CRE_ITEM ~WEPGIAN~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~WEAPON1~ EQUIP
    ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
    ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM2~
  LAF cie500_apply_look_and_voice INT_VAR anim_override = 0xe24f STR_VAR cre = ~cie501~ visual_donor = ~giantfro~ END

