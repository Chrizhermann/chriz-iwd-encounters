  // 5. Build bespoke expansion champions, casters & monsters (CIE501..CIE533)
  // CIE501: Rimehorn Runecaster (Frost Shaman L15)
  COPY_EXISTING ~jklshm.cre~ ~override/cie501.cre~
    LPF cie500_set_core INT_VAR name_tra = 501 xp = 26000 hp = 155 ac = 0 - 6 thac0 = 2 apr = 2 rcld = 100 mr = 20 lvl1 = 15 STR_VAR s_cls = ~CIE5CS1~ END
    SAY NAME1 @501
    SAY NAME2 @501
    ADD_CRE_ITEM ~STAF02~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~WEAPON1~ EQUIP
    ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
    ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM2~
  LAF cie500_apply_look_and_voice INT_VAR anim_override = 0xe248 STR_VAR cre = ~cie501~ visual_donor = ~dlbar1a~ END

