  // 8. Authoritative INI trims for AR9700 harpy packs & AR9801 Stone Nuisance interval
  COPY ~chriz-iwd-encounters/ini_500/ar9700_exp.ini~ ~override/AR9700.INI~
    PATCH_IF !FILE_EXISTS_IN_GAME ~dwmesvge.bcs~ BEGIN
      REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~dwmesvge~ ~%cie500_melee_ai%~
    END
  COPY ~chriz-iwd-encounters/ini_500/ar9801_exp.ini~ ~override/AR9801.INI~

  // 9. Place all bespoke CIE5_* encounters across AR9500-AR9801
  ACTION_FOR_EACH exp_area IN ~ar9500~ ~ar9501~ ~ar9502~ ~ar9600~ ~ar9601~ ~ar9602~ ~ar9603~ ~ar9702~ ~ar9712~ ~ar9714~ ~ar9716~ ~ar9717~ ~ar9718~ ~ar9800~ ~ar9801~ BEGIN
    LAF cie500_place_area_actors STR_VAR area = EVAL ~%exp_area%~ END
  END

  PRINT ~chriz-iwd-encounters: Heart of Winter & Trials of the Luremaster expansion overhaul installed.~
END
