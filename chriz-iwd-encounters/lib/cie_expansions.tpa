// Component 500: Heart of Winter & Trials of the Luremaster expansion overhaul
// (AR9500-AR9801). Repairs SCS 6040's AR9602 64x Xactile actor clobber, thins
// ~45-50% of generic expansion filler mobs via schedule=0, upgrades spongy
// regulars, and places bespoke lore-accurate expansion champions and
// spellcasters with full SCS spellbooks and net XP preserved. Works with and
// without SCS.

// Strip non-generic MYAREA, Malavon warp, StartCutSceneMode, and NumTimesTalkedTo
// blocks directly on a compiled SCS caster BCS without decompiling (preserves
// GTIMES.IDS timers byte-for-byte). Falls back to an authored BAF without SCS.
DEFINE_ACTION_FUNCTION cie500_build_caster_script
  STR_VAR donor = ~~ fallback_baf = ~~ target = ~~
BEGIN
  OUTER_SET used_scs = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%donor%.bcs~ BEGIN
    COPY_EXISTING - ~%donor%.bcs~ nowhere
      PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~instantprep~) >= 0) BEGIN
        SET used_scs = 1
      END
  END
  ACTION_IF used_scs BEGIN
    COPY_EXISTING ~%donor%.bcs~ ~override/%target%.bcs~
      REPLACE_TEXTUALLY EXACT_MATCH ~%WNL%~ ~%LNL%~
      SET pos = 0
      WHILE (pos >= 0) BEGIN
        SET bstart = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~CR%LNL%CO%LNL%~ pos)
        PATCH_IF (bstart < 0) BEGIN
          SET pos = 0 - 1
        END ELSE BEGIN
          SET bend = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~RS%LNL%CR%LNL%~ bstart)
          PATCH_IF (bend < 0) BEGIN
            SET pos = 0 - 1
          END ELSE BEGIN
            SET blen = bend + 6 - bstart
            READ_ASCII bstart blk (blen)
            SET drop = 0
            INNER_PATCH ~%blk%~ BEGIN
              PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"MYAREA~) >= 0)
                  OR (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~MALAVON~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%120OB~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%121OB~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%198OB~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~TR%LNL%16441 ~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~TR%LNL%16442 ~) >= 0)
                  OR (INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~TR%LNL%16443 ~) >= 0) BEGIN
                SET drop = 1
              END
            END
            PATCH_IF drop BEGIN
              DELETE_BYTES bstart blen
              SET pos = bstart
            END ELSE BEGIN
              SET pos = bstart + blen
            END
          END
        END
      END
  END ELSE BEGIN
    COPY ~chriz-iwd-encounters/baf/%fallback_baf%.baf~ ~override/%target%.bcs~
      COMPILE_BAF_TO_BCS
  END
END

// Copy 400-byte soundset (0xA4..0x233) and animation ID (0x28) from a visual donor.
DEFINE_ACTION_FUNCTION cie500_apply_look_and_voice
  INT_VAR anim_override = 0 - 1
  STR_VAR cre = ~~ visual_donor = ~~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%visual_donor%.cre~ BEGIN
    COPY_EXISTING - ~%visual_donor%.cre~ nowhere
      READ_LONG 0x28 v_anim
      READ_ASCII 0x2c v_colors (7)
      READ_ASCII 0xa4 v_sounds (400)
      READ_BYTE 0x271 v_general
      READ_BYTE 0x272 v_race
      READ_BYTE 0x275 v_gender
    COPY_EXISTING ~%cre%.cre~ ~override~
      PATCH_IF (anim_override >= 0) BEGIN
        WRITE_LONG 0x28 anim_override
      END ELSE BEGIN
        WRITE_LONG 0x28 v_anim
      END
      WRITE_ASCIIE 0x2c ~%v_colors%~ (7)
      WRITE_ASCIIE 0xa4 ~%v_sounds%~ (400)
      WRITE_BYTE 0x271 v_general
      WRITE_BYTE 0x272 v_race
      WRITE_BYTE 0x275 v_gender
    BUT_ONLY
  END
END

// Remove all existing items from a cloned CRE so donor quest/unique drops never leak.
DEFINE_PATCH_FUNCTION cie500_clear_all_items BEGIN
  READ_LONG 0x2bc ioff
  READ_LONG 0x2c0 icnt
  FOR (k = icnt - 1; k >= 0; k -= 1) BEGIN
    READ_ASCII (ioff + 0x14 * k) ires (8) NULL
    PATCH_IF (~%ires%~ STRING_COMPARE ~~) BEGIN
      REMOVE_CRE_ITEM ~%ires%~
      READ_LONG 0x2bc ioff
      READ_LONG 0x2c0 icnt
      PATCH_IF (k > icnt) BEGIN SET k = icnt END
    END
  END
END

// Authoritative owned stats & scripts on a bespoke CIE5xx creature.
DEFINE_PATCH_FUNCTION cie500_set_core
  INT_VAR name_tra = 0 xp = 0 hp = 100 ac = 0 thac0 = 5 apr = 2
          sv1 = 5 sv2 = 6 sv3 = 6 sv4 = 7 sv5 = 6
          rfir = 0 rcld = 0 rele = 0 racd = 0 mr = 0 rsl = 0 rcr = 0 rpi = 0 rmi = 0
          lvl1 = 15 lvl2 = 1
  STR_VAR s_ovr = ~~ s_cls = ~~ s_rac = ~~ s_gen = ~~ s_def = ~~
BEGIN
  WRITE_LONG  0x14 xp
  WRITE_LONG  0x20 0 // live state (never dead/stone)
  WRITE_SHORT 0x24 hp
  WRITE_SHORT 0x26 hp
  WRITE_SHORT 0x46 ac
  WRITE_SHORT 0x48 ac
  WRITE_BYTE  0x52 thac0
  WRITE_BYTE  0x53 apr
  WRITE_BYTE  0x54 sv1
  WRITE_BYTE  0x55 sv2
  WRITE_BYTE  0x56 sv3
  WRITE_BYTE  0x57 sv4
  WRITE_BYTE  0x58 sv5
  WRITE_BYTE  0x59 rfir
  WRITE_BYTE  0x5a rcld
  WRITE_BYTE  0x5b rele
  WRITE_BYTE  0x5c racd
  WRITE_BYTE  0x5d mr
  WRITE_BYTE  0x5e rfir
  WRITE_BYTE  0x5f rcld
  WRITE_BYTE  0x60 rsl
  WRITE_BYTE  0x61 rcr
  WRITE_BYTE  0x62 rpi
  WRITE_BYTE  0x63 rmi
  WRITE_BYTE  0x234 lvl1
  WRITE_BYTE  0x235 lvl2
  WRITE_BYTE  0x238 19 // STR
  WRITE_BYTE  0x23a 16 // INT
  WRITE_BYTE  0x23b 16 // WIS
  WRITE_BYTE  0x23c 17 // DEX
  WRITE_BYTE  0x23d 16 // CON
  WRITE_ASCIIE 0x248 ~%s_ovr%~ #8
  WRITE_ASCIIE 0x250 ~%s_cls%~ #8
  WRITE_ASCIIE 0x258 ~%s_rac%~ #8
  WRITE_ASCIIE 0x260 ~%s_gen%~ #8
  WRITE_ASCIIE 0x268 ~%s_def%~ #8
  WRITE_BYTE  0x270 255 // ENEMY
  WRITE_ASCII 0x280 ~~ #32 // empty DV for safe multi-instance
  WRITE_ASCII 0x2cc ~~ #8  // no dialog
  LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete = 20 END  // no baked invisibility
  LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete = 208 END // no immortal MINHP
  LPF cie500_clear_all_items END
END

// Disable a generic placed filler actor at exact (tx, ty) via schedule = 0.
DEFINE_PATCH_FUNCTION cie500_disable_actor_at
  INT_VAR tx = 0 ty = 0
BEGIN
  READ_LONG  0x54 aoff
  READ_SHORT 0x58 acnt
  SET done = 0
  FOR (i = 0; i < acnt AND !done; ++i) BEGIN
    SET here = aoff + 0x110 * i
    READ_SHORT (here + 0x20) ax
    READ_SHORT (here + 0x22) ay
    READ_LONG  (here + 0x40) asched
    READ_ASCII here anm (5) NULL
    PATCH_IF (ax = tx) AND (ay = ty) AND (asched != 0) AND (~%anm%~ STRING_COMPARE_CASE ~CIE5_~) BEGIN
      WRITE_LONG (here + 0x40) 0
      SET done = 1
    END
  END
END

// Restore one AR9602.ARE placed actor row (fixes SCS 6040's 64x XACTILE overwrite)
// and apply schedule thinning in the same authoritative pass.
DEFINE_PATCH_FUNCTION cie500_restore_9602_row
  INT_VAR rx = 0 ry = 0 keep = 1
  STR_VAR rcre = ~~ sovr = ~~ sgen = ~~ scls = ~~ srac = ~~ sdef = ~~ sspc = ~~
BEGIN
  READ_LONG  0x54 aoff
  READ_SHORT 0x58 acnt
  FOR (i = 0; i < acnt; ++i) BEGIN
    SET here = aoff + 0x110 * i
    READ_SHORT (here + 0x20) ax
    READ_SHORT (here + 0x22) ay
    READ_ASCII here anm (5) NULL
    PATCH_IF (ax = rx) AND (ay = ry) AND (~%anm%~ STRING_COMPARE_CASE ~CIE5_~) BEGIN
      WRITE_ASCIIE (here + 0x80) ~%rcre%~ #8
      WRITE_LONG   (here + 0x40) (keep ? 0xffffffff : 0)
      PATCH_IF (~%rcre%~ STRING_EQUAL_CASE ~XACTILE~) BEGIN
        LPF cie_read_script_slot INT_VAR offset = (here + 0x58) RET cur_gen = script END
        LPF cie_read_script_slot INT_VAR offset = (here + 0x60) RET cur_cls = script END
        LPF cie_read_script_slot INT_VAR offset = (here + 0x78) RET cur_spc = script END
        PATCH_IF (~%cur_gen%~ STRING_COMPARE_CASE ~ILXACTIL~)
            AND (~%cur_cls%~ STRING_COMPARE_CASE ~ILXACTIL~)
            AND (~%cur_spc%~ STRING_COMPARE_CASE ~ILXACTIL~) BEGIN
          WRITE_ASCIIE (here + 0x60) ~ILXACTIL~ #8
        END
      END ELSE BEGIN
        PATCH_IF (~%sovr%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT sovr ~%cie500_melee_ai%~ END
        PATCH_IF (~%sgen%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT sgen ~%cie500_melee_ai%~ END
        PATCH_IF (~%scls%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT scls ~%cie500_melee_ai%~ END
        PATCH_IF (~%srac%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT srac ~%cie500_melee_ai%~ END
        PATCH_IF (~%sdef%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT sdef ~%cie500_melee_ai%~ END
        PATCH_IF (~%sspc%~ STRING_EQUAL_CASE ~EFATKMEL~) BEGIN SPRINT sspc ~%cie500_melee_ai%~ END
        WRITE_ASCIIE (here + 0x50) ~%sovr%~ #8
        WRITE_ASCIIE (here + 0x58) ~%sgen%~ #8
        WRITE_ASCIIE (here + 0x60) ~%scls%~ #8
        WRITE_ASCIIE (here + 0x68) ~%srac%~ #8
        WRITE_ASCIIE (here + 0x70) ~%sdef%~ #8
        WRITE_ASCIIE (here + 0x78) ~%sspc%~ #8
      END
    END
  END
END

// Authoritative placement of a CIE5_* bespoke actor from actors_500/<area>/*.actor.
DEFINE_PATCH_FUNCTION cie500_place_actor
  STR_VAR template = ~~
BEGIN
  INNER_PATCH_FILE ~%template%~ BEGIN
    READ_ASCII 0 wanted_name (32) NULL
    READ_SHORT 0x20 wanted_x
    READ_SHORT 0x22 wanted_y
    READ_ASCII 0x70 wanted_def (8) NULL
    READ_ASCII 0x80 wanted_cre (8) NULL
    READ_ASCII 0 wanted_rec (0x110)
  END
  READ_LONG  0x54 aoff
  READ_SHORT 0x58 acnt
  SET found = 0 - 1
  FOR (i = 0; i < acnt; ++i) BEGIN
    SET here = aoff + 0x110 * i
    READ_ASCII here nm (32) NULL
    PATCH_IF (~%nm%~ STRING_EQUAL_CASE ~%wanted_name%~) BEGIN
      SET found = here
    END
  END
  PATCH_IF (found < 0) BEGIN
    READ_ASCII aoff old_tbl (0x110 * acnt)
    SET aoff = BUFFER_LENGTH
    INSERT_BYTES aoff (0x110 * (acnt + 1))
    WRITE_ASCIIE aoff ~%old_tbl%~ (0x110 * acnt)
    SET found = aoff + 0x110 * acnt
    WRITE_LONG  0x54 aoff
    WRITE_SHORT 0x58 (acnt + 1)
  END
  WRITE_ASCIIE found ~%wanted_rec%~ (0x110)
  WRITE_SHORT  (found + 0x20) wanted_x
  WRITE_SHORT  (found + 0x22) wanted_y
  WRITE_SHORT  (found + 0x24) wanted_x
  WRITE_SHORT  (found + 0x26) wanted_y
  WRITE_LONG   (found + 0x28) 9
  WRITE_LONG   (found + 0x40) 0xffffffff
  WRITE_ASCIIE (found + 0x70) ~%wanted_def%~ #8
  WRITE_ASCIIE (found + 0x80) ~%wanted_cre%~ #8
END

DEFINE_ACTION_FUNCTION cie500_place_area_actors
  STR_VAR area = ~~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%area%.are~ BEGIN
    ACTION_BASH_FOR ~chriz-iwd-encounters/actors_500/%area%~ ~.*\.actor~ BEGIN
      COPY_EXISTING ~%area%.are~ ~override~
        LPF cie500_place_actor STR_VAR template = EVAL ~%BASH_FOR_FILESPEC%~ END
      BUT_ONLY
    END
  END
END

DEFINE_ACTION_FUNCTION cie_expansions BEGIN
  // 1. Resolve installed SCS GenAI melee/berserker/ranged/thief scripts (with base-game fallbacks)
  OUTER_SPRINT cie500_melee_ai  ~EFATKMEL~
  OUTER_SPRINT cie500_bersk_ai  ~EFATKMEL~
  OUTER_SPRINT cie500_ranged_ai ~EFATKMEL~
  OUTER_SPRINT cie500_thief_ai  ~EFATKMEL~
  ACTION_IF FILE_EXISTS_IN_GAME ~dwmessge.bcs~ BEGIN OUTER_SPRINT cie500_melee_ai  ~DWMESSGE~ END
  ELSE ACTION_IF FILE_EXISTS_IN_GAME ~dwmesvge.bcs~ BEGIN OUTER_SPRINT cie500_melee_ai ~DWMESVGE~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dwmebrbe.bcs~ BEGIN OUTER_SPRINT cie500_bersk_ai  ~DWMEBRBE~ END
  ELSE ACTION_IF FILE_EXISTS_IN_GAME ~dwmebrge.bcs~ BEGIN OUTER_SPRINT cie500_bersk_ai ~DWMEBRGE~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dwrrssge.bcs~ BEGIN OUTER_SPRINT cie500_ranged_ai ~DWRRSSGE~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dwmethas.bcs~ BEGIN OUTER_SPRINT cie500_thief_ai  ~DWMETHAS~ END
  OUTER_SPRINT cie500_ptn_spd ~POTN14~
  OUTER_SPRINT cie500_ptn_inv ~POTN10~
  OUTER_SPRINT cie500_ptn_st1 ~POTN04~
  OUTER_SPRINT cie500_ptn_st2 ~POTN06~
  ACTION_IF FILE_EXISTS_IN_GAME ~dw#ptn14.itm~ BEGIN OUTER_SPRINT cie500_ptn_spd ~DW#PTN14~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dw#ptn10.itm~ BEGIN OUTER_SPRINT cie500_ptn_inv ~DW#PTN10~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dw#ptn04.itm~ BEGIN OUTER_SPRINT cie500_ptn_st1 ~DW#PTN04~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~dw#ptn06.itm~ BEGIN OUTER_SPRINT cie500_ptn_st2 ~DW#PTN06~ END

  // 2. Compile cell-release helper scripts & build portable plot-free caster AI scripts
  COPY ~chriz-iwd-encounters/baf/cie5wblk.baf~ ~override/cie5wblk.bcs~ COMPILE_BAF_TO_BCS
  COPY ~chriz-iwd-encounters/baf/cie5eblk.baf~ ~override/cie5eblk.bcs~ COMPILE_BAF_TO_BCS
  LAF cie500_build_caster_script STR_VAR donor = ~CAJSHA1~  fallback_baf = ~cie5_priest_fb~ target = ~CIE5CS1~ END
  LAF cie500_build_caster_script STR_VAR donor = ~LDILAIR~  fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS2~ END
  LAF cie500_build_caster_script STR_VAR donor = ~WTKONTIK~ fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS3~ END
  LAF cie500_build_caster_script STR_VAR donor = ~DUHERO5~  fallback_baf = ~cie5_priest_fb~ target = ~CIE5CS4~ END
  LAF cie500_build_caster_script STR_VAR donor = ~DW#LDDR2~ fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS5~ END
  LAF cie500_build_caster_script STR_VAR donor = ~LDKRAMGE~ fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS6~ END
  LAF cie500_build_caster_script STR_VAR donor = ~D3PRES~   fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS7~ END
  LAF cie500_build_caster_script STR_VAR donor = ~LDMALVON~ fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS8~ END
  LAF cie500_build_caster_script STR_VAR donor = ~UDBANDOF~ fallback_baf = ~cie5_mage_fb~   target = ~CIE5CS9~ END

  // 3. Repair AR9602.ARE (SCS 6040 clobbered all 64 actors' CRE fields to XACTILE) & thin filler
  ACTION_IF FILE_EXISTS_IN_GAME ~ar9602.are~ BEGIN
    COPY_EXISTING ~ar9602.are~ ~override~
      LPF cie500_restore_9602_row INT_VAR rx = 517 ry = 1253 keep = 0 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT6MOVE~ scls = ~GNTEAM6S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 409 ry = 1518 keep = 1 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT6MOVE~ scls = ~GNTEAM6S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 444 ry = 1376 keep = 0 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT6MOVE~ scls = ~GNTEAM6S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 771 ry = 1627 keep = 1 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT6MOVE~ scls = ~GNTEAM6S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 650 ry = 1296 keep = 0 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT6MOVE~ scls = ~GNTEAM6S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1049 ry = 545 keep = 1 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 693 ry = 726 keep = 0 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1042 ry = 811 keep = 1 STR_VAR rcre = ~DLSCRAG~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 780 ry = 982 keep = 0 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 864 ry = 1747 keep = 1 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM7S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1267 ry = 1205 keep = 0 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT8MOVE~ scls = ~GNTEAM8S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1688 ry = 925 keep = 1 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT8MOVE~ scls = ~GNTEAM8S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1785 ry = 1245 keep = 0 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT8MOVE~ scls = ~GNTEAM8S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 2245 ry = 1488 keep = 1 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT9MOVE~ scls = ~GNTEAM9S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1298 ry = 500 keep = 0 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1371 ry = 1572 keep = 1 STR_VAR rcre = ~DLSNOTR~ sovr = ~~ sgen = ~GNT7MOVE~ scls = ~GNTEAM7S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~EFTROLG~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1064 ry = 1612 keep = 0 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1180 ry = 1821 keep = 1 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT7MOVE~ scls = ~GNTEAM7S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1543 ry = 1446 keep = 0 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT7MOVE~ scls = ~GNTEAM7S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1223 ry = 989 keep = 1 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT8MOVE~ scls = ~GNTEAM8S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 516 ry = 826 keep = 0 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT5MOVE~ scls = ~GNTEAM5S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 1954 ry = 1020 keep = 1 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT8MOVE~ scls = ~GNTEAM8S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 2105 ry = 1324 keep = 0 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT9MOVE~ scls = ~GNTEAM9S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 2061 ry = 1463 keep = 1 STR_VAR rcre = ~DLICETR~ sovr = ~~ sgen = ~GNT9MOVE~ scls = ~GNTEAM9S~ srac = ~EFATKMEL~ sdef = ~~ sspc = ~~ END
      LPF cie500_restore_9602_row INT_VAR rx = 2657 ry = 760 keep = 0 STR_VAR rcre = ~DLBONEC~ sovr = ~~ sgen = ~~ scls = ~~ srac = ~~ sdef = ~~ sspc = ~EFATKMEL~ END
      LPF cie500_restore_9602_row INT_VAR rx = 3384 ry = 960 keep = 1 STR_VAR rcre = ~DLBONEC~ sovr = ~~ sgen = ~~ scls = ~~ srac = ~~ sdef = ~~ sspc = ~EFATKMEL~ END
