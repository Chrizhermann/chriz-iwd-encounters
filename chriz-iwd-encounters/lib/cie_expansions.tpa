  // 6. Upgrade spongy / low-THAC0 regulars & mini-bosses in-place (preserving quest items/DVs!)
  ACTION_FOR_EACH spgrd IN ~ckspgrd~ ~ckspgrd2~ ~ckspgrd3~ ~ckspgrd4~ ~ckspgrd5~ ~ckspgrd6~ ~ckspgrd7~ ~ckspgrdh~ ~rndspg~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%spgrd%.cre~ BEGIN
      COPY_EXISTING ~%spgrd%.cre~ ~override~
        WRITE_SHORT 0x24 115
        WRITE_SHORT 0x26 115
        WRITE_BYTE  0x52 1
        WRITE_BYTE  0x53 8 // 5/2 APR instead of 1 APR sponge
      BUT_ONLY
    END
  END

  ACTION_IF FILE_EXISTS_IN_GAME ~saprince.cre~ BEGIN
    COPY_EXISTING ~saprince.cre~ ~override~
      WRITE_LONG  0x14 8000
