// Component 370: Cryshal-Tirith, Pomab and his images (AR1103, Easthaven), designed
// with Christopher on 2026-11-03 and 2026-11-04. Works with and without SCS.
//   - A true shell game: the images carry the real Pomab's name; each time he is hit,
//     he and every image left jump, each to another of his points, and the images
//     hide again what a revealing spell showed. Between shots they keep their
//     distance.
//   - His Cryshal Sentries guard him: they go for whoever last attacked him and for
//     enemies close to him; 240 hit points; from Core Rules up they play dead for half
//     as long.
//   - Repairs: every hit on the real Pomab removes an image (his own full heal could
//     come before the area script counted the hit); his checks read the image counter
//     (FAKE_POMAB_DEAD was never set); a sentry healed while playing dead still stands
//     up; the sentries' caster targeting works.
// docs/components.md describes each change in engine-neutral terms.

DEFINE_ACTION_FUNCTION cie_cryshal BEGIN
  OUTER_SPRINT cie_cry_area_script ~~
  COPY_EXISTING ~ar1103.are~ ~override~
    READ_ASCII 0x94 cie_cry_area_script (8) NULL
  BUT_ONLY
  ACTION_IF (~%cie_cry_area_script%~ STRING_EQUAL ~~) OR (~%cie_cry_area_script%~ STRING_EQUAL_CASE ~NONE~)
      OR (!FILE_EXISTS_IN_GAME ~%cie_cry_area_script%.bcs~) BEGIN
    FAIL ~chriz-iwd-encounters: ar1103.are has no area script.~
  END

  // the real Pomab (created by the fight's cutscene): name, script name, scripts in
  // the order they run (override, class, race, general, default)
  OUTER_SET cie_cry_name = 0 - 1
  OUTER_SPRINT cie_cry_real ~~
  OUTER_SET cie_cry_real_count = 0
  COPY_EXISTING ~eepomab.cre~ ~override~
    READ_ASCII 0 signature (8)
    PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
      READ_LONG 0x08 cie_cry_name
      READ_ASCII 0x280 cie_cry_real (32) NULL
      FOR (slot = 0x248; slot < 0x270; slot += 8) BEGIN
        LPF cie_read_script_slot INT_VAR offset = slot RET script END
        PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (FILE_EXISTS_IN_GAME ~%script%.bcs~) BEGIN
          SPRINT $cie_cry_real_scripts(~%cie_cry_real_count%~) ~%script%~
          SET cie_cry_real_count += 1
        END
      END
    END
  BUT_ONLY
  ACTION_IF (cie_cry_real_count = 0) OR (~%cie_cry_real%~ STRING_EQUAL ~~) BEGIN
    FAIL ~chriz-iwd-encounters: the real Pomab (eepomab.cre) has no script or no script name.~
  END

  // his images: the same name as he has; their script names and scripts
  OUTER_SET cie_cry_image_count = 0
  OUTER_FOR (n = 1; n <= 5; ++n) BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~pomimg%n%.cre~ BEGIN
      COPY_EXISTING ~pomimg%n%.cre~ ~override~
        READ_ASCII 0 signature (8)
        PATCH_IF (~%signature%~ STRING_EQUAL ~CRE V1.0~) BEGIN
          READ_ASCII 0x280 dv (32) NULL
          WRITE_LONG 0x08 cie_cry_name
          SET first = 1
          FOR (slot = 0x248; slot < 0x270; slot += 8) BEGIN
            LPF cie_read_script_slot INT_VAR offset = slot RET script END
            PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (FILE_EXISTS_IN_GAME ~%script%.bcs~) BEGIN
              SPRINT $cie_cry_image_scripts(~%script%~) ~1~
              PATCH_IF first BEGIN
                SPRINT $cie_cry_image_first(~%script%~) ~1~
                SET first = 0
              END
            END
          END
          PATCH_IF (~%dv%~ STRING_COMPARE ~~) BEGIN
            SPRINT $cie_cry_images(~%cie_cry_image_count%~) ~%dv%~
            SET cie_cry_image_count += 1
          END
        END
      BUT_ONLY
    END
  END
  PRINT ~chriz-iwd-encounters: Pomab (%cie_cry_real%) and %cie_cry_image_count% image(s) carry the same name.~

  // his points: where his own script moves and jumps him
  OUTER_SET cie_cry_points = 0
  OUTER_FOR (i = 0; i < cie_cry_real_count; ++i) BEGIN
    OUTER_SPRINT script $cie_cry_real_scripts(~%i%~)
    COPY_EXISTING ~%script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~\(Move\|Jump\)ToPoint(\[\([0-9]+\)\.\([0-9]+\)\])~ BEGIN
          PATCH_IF (!VARIABLE_IS_SET $cie_cry_seen(~%MATCH2%~ ~%MATCH3%~)) BEGIN
            SET $cie_cry_seen(~%MATCH2%~ ~%MATCH3%~) = 1
            SET $cie_cry_px(~%cie_cry_points%~) = MATCH2
            SET $cie_cry_py(~%cie_cry_points%~) = MATCH3
            SET cie_cry_points += 1
          END
        END ~%MATCH0%~
      END
    BUT_ONLY
  END

  LAF cie_cryshal_shuffle RET cie_cry_counts END
  LAF cie_cryshal_pomab END
  LAF cie_cryshal_sentries END
END

// The shuffle. The area script counts a hit on the real Pomab and removes an image
// (base game); it now also sets CIE_POM_SHUFFLE, and a block on top of it then heals
// him fully (his own script did that before, sometimes before the hit was counted),
// lifts a reveal from him and every image left (CIEPOMRC removes OHPOMREV's glow and
// translucency, CIEPOMIL - OHPOMILL aimed at its target - makes them illusions again)
// and makes them all jump: each
// response is one arrangement with each of them on another point.
DEFINE_ACTION_FUNCTION cie_cryshal_shuffle
  RET cie_cry_counts
BEGIN
  OUTER_SET cie_cry_counts = 0
  ACTION_IF (cie_cry_points = 0) OR (!FILE_EXISTS_IN_GAME ~cdhp3000.spl~) OR (!FILE_EXISTS_IN_GAME ~ohpomill.spl~) BEGIN
    WARN ~chriz-iwd-encounters: Pomab's points, his heal (cdhp3000.spl) or the illusion spell (ohpomill.spl) are missing; no shuffle.~
  END ELSE BEGIN
    COPY_EXISTING ~cdhp3000.spl~ ~override/ciepomrc.spl~
      LPF DELETE_SPELL_EFFECT INT_VAR opcode_to_delete = (0 - 1) END
      LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 2 timing = 1 resist_dispel = 2 STR_VAR resource = ~OHPOMREV~ END
    // OHPOMILL targets its caster; applied by the area script it has to target the creature
    COPY_EXISTING ~ohpomill.spl~ ~override/ciepomil.spl~
      LPF ALTER_SPELL_HEADER INT_VAR target = 1 END
      LPF ALTER_SPELL_EFFECT INT_VAR target = 2 END

    OUTER_SPRINT cie_cry_shuffle ~IF%LNL%  Global("CIE_POM_SHUFFLE","MYAREA",1)%LNL%THEN%LNL%~
    OUTER_FOR (r = 0; r < cie_cry_points; ++r) BEGIN
      OUTER_SPRINT cie_cry_shuffle ~%cie_cry_shuffle%  RESPONSE #100%LNL%    SetGlobal("CIE_POM_SHUFFLE","MYAREA",0)%LNL%    ApplySpellRES("CDHP3000","%cie_cry_real%")%LNL%~
      OUTER_FOR (k = 0; k <= cie_cry_image_count; ++k) BEGIN
        ACTION_IF (k = 0) BEGIN
          OUTER_SPRINT who ~%cie_cry_real%~
        END ELSE BEGIN
          OUTER_SET j = k - 1
          OUTER_SPRINT who $cie_cry_images(~%j%~)
        END
        OUTER_SET p = (r + k) MODULO cie_cry_points
        OUTER_SET x = $cie_cry_px(~%p%~)
        OUTER_SET y = $cie_cry_py(~%p%~)
        OUTER_SPRINT cie_cry_shuffle ~%cie_cry_shuffle%    ApplySpellRES("CIEPOMRC","%who%")%LNL%    ApplySpellRES("CIEPOMIL","%who%")%LNL%    CreateVisualEffectObject("ILLUSH","%who%")%LNL%    ClearActions("%who%")%LNL%    ActionOverride("%who%",JumpToPoint([%x%.%y%]))%LNL%~
      END
    END
    OUTER_SPRINT cie_cry_shuffle ~%cie_cry_shuffle%END%LNL%%LNL%~

    COPY_EXISTING ~%cie_cry_area_script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~IncrementGlobal("SPRITE_IS_DEADFAKE_POMAB","GLOBAL",1)~ BEGIN
          SET cie_cry_counts += 1
        END ~%MATCH0%%LNL%    SetGlobal("CIE_POM_SHUFFLE","MYAREA",1)~
        PATCH_IF (cie_cry_counts > 0) BEGIN
          LPF cie_replace_text INT_VAR start = 0 STR_VAR text = EVAL ~%cie_cry_shuffle%~ END
        END
      END
    BUT_ONLY
    ACTION_IF (cie_cry_counts = 0) BEGIN
      WARN ~chriz-iwd-encounters: %cie_cry_area_script%.bcs does not count hits on Pomab (SPRITE_IS_DEADFAKE_POMAB); no shuffle.~
    END ELSE BEGIN
      PRINT ~chriz-iwd-encounters: each of the %cie_cry_counts% hits the area script counts on Pomab shuffles him and his images over %cie_cry_points% points.~
    END
  END
END

// Pomab's and the images' own scripts.
DEFINE_ACTION_FUNCTION cie_cryshal_pomab BEGIN
  OUTER_SPRINT cie_cry_kite ~IF%LNL%  GlobalLT("SPRITE_IS_DEADFAKE_POMAB","GLOBAL",5)%LNL%  See(NearestEnemyOf(Myself))%LNL%  Range(NearestEnemyOf(Myself),8)%LNL%THEN%LNL%  RESPONSE #100%LNL%    RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),15)%LNL%END%LNL%%LNL%~
  OUTER_SET cie_cry_heals = 0
  OUTER_SET cie_cry_kites = 0
  // the real one: no own full heal and jump once the area script does it; the image
  // counter instead of FAKE_POMAB_DEAD; keeping his distance before he wanders
  OUTER_FOR (i = 0; i < cie_cry_real_count; ++i) BEGIN
    OUTER_SPRINT script $cie_cry_real_scripts(~%i%~)
    COPY_EXISTING ~%script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        PATCH_IF (cie_cry_counts > 0) BEGIN
          SET from = 0
          WHILE (from >= 0) BEGIN
            LPF cie_find_baf_block INT_VAR from STR_VAR text = ~"CDHP3000"~ RET start end END
            PATCH_IF (start < 0) BEGIN
              SET from = 0 - 1
            END ELSE BEGIN
              READ_ASCII start block (end - start)
              SET jump = 0 - 1
              INNER_PATCH ~%block%~ BEGIN
                SET jump = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~JumpToPoint(~)
              END
              PATCH_IF (jump >= 0) BEGIN
                DELETE_BYTES start (end - start)
                SET cie_cry_heals += 1
                SET from = start
              END ELSE BEGIN
                SET from = end
              END
            END
          END
        END
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~"FAKE_POMAB_DEAD"~ ~"SPRITE_IS_DEADFAKE_POMAB"~
        LPF cie_find_baf_block STR_VAR text = ~MoveToPoint(~ RET start end END
        PATCH_IF (start >= 0) BEGIN
          LPF cie_replace_text INT_VAR start STR_VAR text = EVAL ~%cie_cry_kite%~ END
          SET cie_cry_kites += 1
        END
      END
    BUT_ONLY
  END
  OUTER_SPRINT script $cie_cry_real_scripts(~0~)
  EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_cryshal_pressed.baf~
  EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_cryshal_pomab.baf~ EVALUATE_BUFFER

  // the images: keeping their distance before they wander; revealed again after a
  // shuffle
  ACTION_PHP_EACH cie_cry_image_scripts AS script => unused BEGIN
    COPY_EXISTING ~%script%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        LPF cie_find_baf_block STR_VAR text = ~MoveToPoint(~ RET start end END
        PATCH_IF (start >= 0) BEGIN
          LPF cie_replace_text INT_VAR start STR_VAR text = EVAL ~%cie_cry_kite%~ END
          SET cie_cry_kites += 1
        END
      END
    BUT_ONLY
  END
  ACTION_PHP_EACH cie_cry_image_first AS script => unused BEGIN
    EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_cryshal_pomab.baf~ EVALUATE_BUFFER
  END
  PRINT ~chriz-iwd-encounters: Pomab's own full heal left %cie_cry_heals% script(s); %cie_cry_kites% script(s) keep their distance.~
END

// The Cryshal Sentries: a copy of their creature with 240 hit points (CIESENTR, for
// this area only), and their script.
DEFINE_ACTION_FUNCTION cie_cryshal_sentries BEGIN
  OUTER_SET cie_cry_sentries = 0
  OUTER_SET cie_cry_copied = 0
  COPY_EXISTING ~ar1103.are~ ~override~
    GET_OFFSET_ARRAY actors ARE_V10_ACTORS
    PHP_EACH actors AS index => actor BEGIN
      READ_ASCII (actor + 0x80) cre (8) NULL
      TO_UPPER cre
      PATCH_IF (~%cre%~ STRING_EQUAL ~SENTRY~) BEGIN
        SET cie_cry_sentries += 1
        FOR (slot = 0x50; slot < 0x80; slot += 8) BEGIN
          LPF cie_read_script_slot INT_VAR offset = (actor + slot) RET script END
          PATCH_IF (~%script%~ STRING_COMPARE ~~) AND (FILE_EXISTS_IN_GAME ~%script%.bcs~) BEGIN
            SPRINT $cie_cry_sentry_scripts(~%script%~) ~1~
          END
        END
        LPF cie_embedded_cre INT_VAR actor RET embedded = offset END
        PATCH_IF (embedded = 0) BEGIN
          WRITE_ASCII (actor + 0x80) ~CIESENTR~ (8)
          SET cie_cry_copied += 1
        END
      END
    END
  BUT_ONLY
  ACTION_IF (cie_cry_sentries = 0) BEGIN
    WARN ~chriz-iwd-encounters: ar1103.are places no Cryshal Sentries (sentry.cre); they stay as they are.~
  END ELSE BEGIN
    ACTION_IF (cie_cry_copied > 0) BEGIN
      COPY_EXISTING ~sentry.cre~ ~override/CIESENTR.cre~
        LPF cie_raise_creature INT_VAR hp = 240 RET old_hp old_apr old_thac0 END
      PRINT ~chriz-iwd-encounters: %cie_cry_copied% Cryshal Sentries (CIESENTR) have %old_hp% -> 240 hit points.~
    END
    ACTION_IF (cie_cry_copied < cie_cry_sentries) BEGIN
      WARN ~chriz-iwd-encounters: some Cryshal Sentries carry their own creature in ar1103.are; their hit points stay.~
    END

    ACTION_PHP_EACH cie_cry_sentry_scripts AS script => unused BEGIN
      OUTER_SET cie_cry_down_hp = 10
      OUTER_SET cie_cry_timer = 0
      OUTER_SET cie_cry_wake = 0
      OUTER_SET cie_cry_targeting = 0
      COPY_EXISTING ~%script%.bcs~ ~override~
        DECOMPILE_AND_PATCH BEGIN
          // from Core Rules up, play dead for half as long
          LPF cie_find_baf_block STR_VAR text = ~SetGlobalTimer("OH_Dead_Timer","LOCALS",~ RET start end END
          PATCH_IF (start >= 0) BEGIN
            READ_ASCII start block (end - start)
            SET seconds = 0
            INNER_PATCH ~%block%~ BEGIN
              REPLACE_EVALUATE ~SetGlobalTimer("OH_Dead_Timer","LOCALS",\([0-9]+\))~ BEGIN
                SET seconds = MATCH1
              END ~%MATCH0%~
              REPLACE_EVALUATE ~HPLT(Myself,\([0-9]+\))~ BEGIN
                SET cie_cry_down_hp = MATCH1
              END ~%MATCH0%~
            END
            PATCH_IF (seconds > 1) BEGIN
              SET half = seconds / 2
              INNER_PATCH_SAVE copy ~%block%~ BEGIN
                REPLACE_TEXTUALLY ~^IF~ ~IF%LNL%  DifficultyGT(EASY)~
                REPLACE_TEXTUALLY ~SetGlobalTimer("OH_Dead_Timer","LOCALS",[0-9]+)~ ~SetGlobalTimer("OH_Dead_Timer","LOCALS",%half%)~
              END
              LPF cie_replace_text INT_VAR start STR_VAR text = EVAL ~%copy%%LNL%%LNL%~ END
              SET cie_cry_timer = half
            END
          END
          // a sentry healed while it plays dead still stands up when its time is up
          LPF cie_find_baf_block STR_VAR text = ~SetSequence(AWAKE)~ RET start end END
          PATCH_IF (start >= 0) BEGIN
            READ_ASCII start block (end - start)
            SET removed = 0
            INNER_PATCH_SAVE fixed ~%block%~ BEGIN
              REPLACE_EVALUATE ~[ ]*HPLT(Myself,[0-9]+)[%MNL%]?%LNL%~ BEGIN
                SET removed += 1
              END ~~
            END
            PATCH_IF (removed > 0) BEGIN
              LPF cie_replace_text INT_VAR start length = (end - start) STR_VAR text = EVAL ~%fixed%~ END
              SET cie_cry_wake = 1
            END
          END
          // casters first, then the nearest enemy (inside one OR the nearest enemy
          // came first and took every turn)
          LPF cie_find_baf_block STR_VAR text = ~See(NearestEnemyOf(Myself))~ RET start end END
          PATCH_IF (start >= 0) BEGIN
            READ_ASCII start block (end - start)
            SET period = 0
            SET ors = 0
            INNER_PATCH ~%block%~ BEGIN
              REPLACE_EVALUATE ~AttackReevaluate(LastSeenBy(Myself),\([0-9]+\))~ BEGIN
                SET period = MATCH1
              END ~%MATCH0%~
              REPLACE_EVALUATE ~OR(\([0-9]+\))~ BEGIN
                SET ors = MATCH1
              END ~%MATCH0%~
            END
            PATCH_IF (period > 0) AND (ors > 1) BEGIN
              SET ors -= 1
              INNER_PATCH_SAVE fixed ~%block%~ BEGIN
                REPLACE_TEXTUALLY ~[ ]*See(NearestEnemyOf(Myself))[%MNL%]?%LNL%~ ~~
                REPLACE_TEXTUALLY ~OR([0-9]+)~ ~OR(%ors%)~
              END
              SPRINT nearest ~IF%LNL%  See(NearestEnemyOf(Myself))%LNL%THEN%LNL%  RESPONSE #100%LNL%    AttackReevaluate(NearestEnemyOf(Myself),%period%)%LNL%END~
              LPF cie_replace_text INT_VAR start length = (end - start) STR_VAR text = EVAL ~%fixed%%LNL%%LNL%%nearest%~ END
              SET cie_cry_targeting = 1
            END
          END
        END
      BUT_ONLY
      EXTEND_TOP ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_cryshal_sentry.baf~ EVALUATE_BUFFER
      EXTEND_BOTTOM ~%script%.bcs~ ~chriz-iwd-encounters/baf/cie_cryshal_return.baf~ EVALUATE_BUFFER
      PRINT ~chriz-iwd-encounters: the sentries' %script% guards %cie_cry_real%; play dead from Core Rules up %cie_cry_timer% s (0 = unchanged), wake-up fixed %cie_cry_wake%, caster targeting fixed %cie_cry_targeting%.~
    END
  END
END
