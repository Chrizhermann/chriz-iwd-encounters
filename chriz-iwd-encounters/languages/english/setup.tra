@9000 = ~This mod is for Icewind Dale: Enhanced Edition.~
@9001 = ~This component needs Sword Coast Stratagems' smarter mages or smarter priests.~
@9002 = ~This component needs Sword Coast Stratagems' smarter priests.~
@9003 = ~This component needs Belhifet (belhif.cre) and the final area (ar1105.are).~
@9004 = ~This component needs Yxunomei's temple (ar4005.are) and Yxunomei (tanarri.cre).~
@9005 = ~This component needs Kuldahar (ar2100.are).~
@9006 = ~This component needs Joril's throne room (ar7004.are).~
@9007 = ~This component needs Maiden Ilmadia (ilmadia.cre) and her forge (ar8011.are).~
@9008 = ~This component needs the Idol (idol.cre) and Poquelin's temple (ar8012.are).~
@9009 = ~This component needs Poquelin (poquelin.cre) and the Ascension Cave (ar8013.are).~
@9010 = ~This component needs Cryshal-Tirith (ar1103.are) and Pomab (eepomab.cre).~
@9011 = ~This component needs Mebdinga (mebding.cre) and her barrow (ar9400.are).~
@9012 = ~This component needs Icasaracht (icasa.cre) and her lair (ar9604.are).~
@9013 = ~This component needs Lord Maluradek (lordm.cre) and his floor (ar9712.are).~
@9014 = ~This component needs the Luremaster (trgbard.cre) and his hall (ar9711.are).~
@9015 = ~This component needs Heart of Winter and Trials of the Luremaster (ar9500.are, ar9714.are).~
